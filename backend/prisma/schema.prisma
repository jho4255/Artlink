generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 사용자 모델
model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String
  nickname        String?   @unique // 공개 표시명 (설정 시 이름 대신 노출), 중복 불가
  /// 홈페이지 주소 `/@handle` (소문자·숫자·`.`·`_` 3~30자, 인스타그램 아이디 규칙). 없으면 인스타 아이디에서
  /// 한 번 자동으로 만든다(lib/handle.ts `ensureHandle`, 2026-09-16). 숫자 주소 `/portfolio/:id` 는 계속 유효.
  handle          String?   @unique
  role            String // ARTIST, GALLERY, ADMIN
  avatar          String?
  phone           String? // 가입 시 입력받는 연락처 (기존 유저는 null 허용)
  instagramUrl    String? // 작가 프로필 인스타그램 주소 (선택)
  password        String? // bcrypt hash (LOCAL auth only)
  provider        String    @default("LOCAL") // LOCAL, KAKAO, NAVER, GOOGLE
  providerId      String? // OAuth provider user ID
  deletedAt       DateTime? // 회원탈퇴(소프트 삭제) 시각. null 아니면 로그인 차단 + 공개 표시 '탈퇴한 회원'
  lastSeenAt      DateTime? // 최근 인증된 접속 시각. 기존 유저는 다음 접속 전까지 null
  /// 가입 시 약관 동의 시각. **동의한 사실과 시점을 남긴다** — 분쟁 시 근거가 된다.
  /// null = 이 기능(2026-09-04) 이전에 가입한 회원. 소급해서 동의한 것으로 치지 않는다.
  termsAgreedAt   DateTime?
  privacyAgreedAt DateTime?
  /// 이메일을 인증번호로 확인한 시각 (2026-10-08). 갤러리 이메일 가입은 가입할 때 확인하고, 비밀번호 찾기도 확인으로 친다.
  /// null = 확인한 적 없는 주소(카카오 가입 화면에서 직접 적은 것 등). 관리자가 갤러리 승인 때 이 표시를 보고 그 갤러리 메일인지 판단한다.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  galleries             Gallery[]
  reviews               Review[]
  favorites             Favorite[]
  portfolio             Portfolio?
  applications          Application[]
  notifications         Notification[]
  pushTokens            PushToken[]
  homepageInquiries     HomepageInquiry[]      @relation("homepageInquiryOwner")
  dailyVisits           DailyVisit[]
  portfolioExports      PortfolioExport[]
  inquiries             Inquiry[]
  portfolioImageLikes   PortfolioImageLike[]
  sentMessages          Message[]              @relation("sentMessages")
  receivedMessages      Message[]              @relation("receivedMessages")
  messageReports        MessageReport[]        @relation("messageReports")
  chatParticipations    ChatParticipant[]
  chatMessages          ChatMessage[]          @relation("chatSender")
  chatsCreated          Chat[]                 @relation("chatCreator")
  blocksMade            UserBlock[]            @relation("blocker") // 내가 차단한 사람(ArtTalk, 2026-11-19)
  blocksReceived        UserBlock[]            @relation("blocked") // 나를 차단한 사람
  chatReportsMade       ChatReport[]           @relation("chatReporter")
  chatReportsReceived   ChatReport[]           @relation("chatReportTarget")
  exhibitionSubmissions ExhibitionSubmission[]
  submissionEdits       ExhibitionSubmission[] @relation("submissionEditor") // 갤러리/Admin 이 대신 입력해 준 작가 자료
  artworkSales          ArtworkSale[]          @relation("artworkSales")
  artistSettlements     ArtistSettlement[]     @relation("artistSettlements")
  settlementApprovals   SettlementApproval[]   @relation("settlementApprovals")
  artworkScraps         ArtworkScrap[]         @relation("artworkScraps")
  invitesReceived       ExhibitionInvite[]     @relation("invitesReceived")
  invitesSent           ExhibitionInvite[]     @relation("invitesSent")
  kanbanBoards          KanbanBoard[]          @relation("kanbanBoardCreator")
  kanbanCardsAssigned   KanbanCard[]           @relation("kanbanAssignee")
  kanbanCardsCreated    KanbanCard[]           @relation("kanbanCardCreator")
  kanbanComments        KanbanComment[]        @relation("kanbanCommentAuthor")
  posts                 Post[]                 @relation("postAuthor")
  postComments          PostComment[]          @relation("postCommentAuthor")
  postLikes             PostLike[]             @relation("postLiker")
  postDrafts            PostDraft[]            @relation("postDraftAuthor")
  postAssets            PostAsset[]            @relation("postAssets")
  communityWriter       CommunityWriter?       @relation("communityWriter")
  postPollVotes         PostPollVote[]         @relation("postPollVoter")
  following             Follow[]               @relation("follower") // 내가 이웃 추가한 사람들
  followers             Follow[]               @relation("following") // 나를 이웃 추가한 사람들
  stories               Story[]                @relation("storyAuthor")
  storyLikes            StoryLike[]            @relation("storyLiker")
  storyComments         StoryComment[]         @relation("storyCommentAuthor")
  storyHighlights       StoryHighlight[]       @relation("storyHighlights")
  storyReports          StoryReport[]          @relation("storyReporter")
  storyMutes            StoryMute[]            @relation("storyMuter") // 내가 그만 보기 한 사람
  storyMutedBy          StoryMute[]            @relation("storyMuted") // 나를 그만 보기 한 사람
  guestbookReceived     GuestbookEntry[]       @relation("guestbookTarget") // 내 방명록에 달린 글
  guestbookWritten      GuestbookEntry[]       @relation("guestbookAuthor") // 내가 남긴 방명록 글

  @@unique([provider, providerId])
}

// ── 방명록 (작가 홈페이지의 방명록) ──
// target 의 홈페이지에 author 가 남긴 글. 방 주인은 답글(parentId)을 달 수 있다.
// secret 이면 방 주인과 작성자만 본문을 볼 수 있다.
model GuestbookEntry {
  id           Int              @id @default(autoincrement())
  targetUserId Int
  target       User             @relation("guestbookTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  authorId     Int
  author       User             @relation("guestbookAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body         String
  secret       Boolean          @default(false)
  parentId     Int?
  parent       GuestbookEntry?  @relation("guestbookReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      GuestbookEntry[] @relation("guestbookReplies")
  createdAt    DateTime         @default(now())

  @@index([targetUserId, createdAt])
}

// ── 이웃 (단방향 팔로우) ──
// follower → following. 상대 수락 불필요. following 에게 알림만 간다.
model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId Int
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ── 스토리 (작업 중 사진 + 짧은 글) ──
// visibility 는 **글마다** — PUBLIC(전체공개) | NEIGHBORS(이웃공개).
// 2026-11-14 부터 전체공개 소식은 **홈 ArtStory 줄**에서 이웃이 아니어도 누구나 본다(블라인드 스토리 방식, CLAUDE.md 규칙 81).
// 그래서 기본값이 PUBLIC 이다(그 전엔 NEIGHBORS). 이미 있는 소식의 값은 바꾸지 않았다.
model Story {
  id           Int            @id @default(autoincrement())
  authorId     Int
  author       User           @relation("storyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  caption      String         @default("")
  images       String[]       @default([])
  visibility   String         @default("PUBLIC") // PUBLIC | NEIGHBORS
  /// 글만 있는 소식의 바탕색 이름(lib/storyRules.ts STORY_BG_KEYS 중 하나). 사진 소식·옛 소식은 null(화면이 첫 색을 쓴다)
  bg           String?
  /// 사진 위 글 (2026-11-14) — `[{ i: 사진 번호, text, x, y(사진 안 0~1 가운데 자리), size: s|m|l, style: plain|dark|light }]`, 사진 하나에 하나.
  /// 사진 원본은 그대로 두고 글을 따로 얹는다(작품 사진에 글을 구워 넣지 않는다 — 원본 보존·선명한 글·화면 낭독기)
  overlays     Json?
  /// 운영이 내렸거나 신고가 쌓여 저절로 내려간 시각 — 주인·관리자 말고는 없는 소식으로 친다(404). 지우지는 않는다
  hiddenAt     DateTime?
  /// 'ADMIN' | 'REPORTS' — 누가 내렸나(주인에게 알릴 말이 다르다)
  hiddenReason String?
  /// 관리자가 되살린 시각 — 그 뒤에 들어온 신고만 다시 센다(되살린 소식이 옛 신고로 곧바로 다시 내려가지 않게)
  reviewedAt   DateTime?
  likeCount    Int            @default(0) // 비정규화 카운트
  commentCount Int            @default(0)
  likes        StoryLike[]
  comments     StoryComment[]
  reports      StoryReport[]
  createdAt    DateTime       @default(now())

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([visibility, createdAt])
}

/// 소식 신고 (2026-11-14) — 한 사람이 한 소식에 한 번. 서로 다른 3명이 신고하면 소식이 저절로 내려가고 관리자가 확인한다.
model StoryReport {
  id         Int      @id @default(autoincrement())
  storyId    Int
  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  reporterId Int
  reporter   User     @relation("storyReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String // SPAM | INAPPROPRIATE | ABUSE | COPYRIGHT | OTHER
  createdAt  DateTime @default(now())

  @@unique([storyId, reporterId])
  @@index([createdAt])
}

/// 이 사람 소식 그만 보기 (2026-11-14) — 내 화면(홈 줄·ArtStory)에서만 빠진다. 상대는 모른다. 홈페이지에는 그대로 있다.
model StoryMute {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation("storyMuter", fields: [userId], references: [id], onDelete: Cascade)
  mutedUserId Int
  mutedUser   User     @relation("storyMuted", fields: [mutedUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, mutedUserId])
}

model StoryLike {
  id        Int      @id @default(autoincrement())
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("storyLiker", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
}

model StoryComment {
  id        Int      @id @default(autoincrement())
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation("storyCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([storyId, createdAt])
}

// ── 스토리 하이라이트 (인스타그램 하이라이트처럼 프로필에 영구 보존) ──
model StoryHighlight {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation("storyHighlights", fields: [userId], references: [id], onDelete: Cascade)
  /// 하이라이트 이름 (e.g., "좋아요", "여행")
  name         String
  /// 이 하이라이트에 포함된 Story id 배열
  storyIds     Int[]    @default([])
  /// 커버 사진으로 사용할 Story (첫 번째 스토리 또는 선택한 스토리)
  coverStoryId Int?
  /// 공개 여부 (기본값: true)
  isPublic     Boolean  @default(true)
  /// 프로필에서 표시 순서
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, order])
}

// ── 광고 배너 (Admin 관리) — 사이드바 하단 등에 노출하는 자체 광고 슬롯 ──
model AdBanner {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  title     String   @default("")
  linkUrl   String   @default("")
  active    Boolean  @default(true)
  position  Int      @default(0) // 정렬(작을수록 먼저)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

// ── 커뮤니티 게시판 (블라인드식 글로벌 게시판, 홈 인기글의 출처) ──
/// 커뮤니티 탭(말머리) — **Admin 만** 만들고 고친다.
/// 탭을 지워도 글은 안 지운다(onDelete: SetNull → '미분류'로 내려온다).
model PostCategory {
  id             Int         @id @default(autoincrement())
  name           String      @unique
  /// 목록 쿼리(?category=)와 주소에 쓰는 키. 한글 이름과 별개로 안정적이어야 한다.
  slug           String      @unique
  /// 탭 순서 (작을수록 앞). 같으면 id 순
  order          Int         @default(0)
  /// 끄면 탭이 안 보인다 — 글은 그대로 남는다(삭제 대신 쓰는 안전한 숨기기)
  active         Boolean     @default(true)
  /// 켜면 **Admin 만 이 탭에 글을 쓸 수 있다**(공지 탭 등). 읽기는 그대로 공개.
  /// ⚠️ 탭 이름이 '공지'인지로 판단하지 않는다 — 이름을 '안내'로 바꾸는 순간 조용히 풀린다.
  /// 2026-11-13 부터 판정은 `writePolicy` 다. 이 칸은 `writePolicy === 'admin'` 과 **늘 같게** 맞춰 둔다
  /// (배포 중 잠깐 도는 옛 서버·옛 화면이 이 칸을 읽는다 — 지우지 말 것).
  writeAdminOnly Boolean     @default(false)
  /// 누가 쓰나 (2026-11-13) — 'all'(로그인한 누구나) | 'writers'(필진 + 관리자) | 'admin'(관리자만). lib/communityAccess.ts
  writePolicy    String      @default("all")
  /// 목록 모양 — 'list'(제목 목록) | 'card'(표지 카드). 필진이 쓰는 긴 글 탭은 카드가 어울린다
  layout         String      @default("list")
  /// 익명 글 허용. 끄면 이 탭의 글은 늘 실명이다(필진 탭)
  allowAnonymous Boolean     @default(true)
  /// 탭 머리에 보이는 한 줄 소개(선택)
  description    String?
  /// 기본 탭(자유게시판, 2026-11-21 사용자 결정 — "탭 없음은 없애고 그런 건 자유게시판으로") — 탭을 안 고른 글·지운 탭의 글이 여기로 간다.
  /// 지우거나 숨길 수 없다. 이름은 바꿀 수 있다(그래서 이름이 아니라 이 칸으로 찾는다). lib/communityAccess.ts ensureDefaultTab
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  posts          Post[]
  drafts         PostDraft[]

  @@index([order])
}

model Post {
  id           Int           @id @default(autoincrement())
  authorId     Int
  author       User          @relation("postAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  /// 어느 탭의 글인가. null 이면 '미분류'(전체 탭에만 뜬다)
  categoryId   Int?
  category     PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// 공지글 — Admin 만 지정. 목록에서 배지가 붙는다
  notice       Boolean       @default(false)
  /// 고정 시각. null 이면 고정 아님. **Boolean 이 아니라 시각인 이유**: 고정 글이 여럿일 때
  /// 순서가 있어야 한다(최근에 고정한 것이 위). Admin 만 바꾼다
  pinnedAt     DateTime?
  title        String
  /// 옛 글은 본문 그대로. **문서 글(`doc` 있음)이면 문서에서 뽑은 글만** 들어 있다(발췌·멘션·검색용, 서버가 만든다)
  body         String
  /// 사진 주소 (우리 저장소만). 옛 글은 첨부 순서, 문서 글은 **문서 속 순서** 그대로(서버가 뽑는다)
  images       String[]      @default([])
  /// 글 문서 (2026-11-13, 블로그형 편집기) — TipTap(ProseMirror) JSON. null 이면 옛 글(본문 + 맨 아래 사진).
  /// 서버가 `lib/postDoc.ts` 허용 목록으로 걸러 저장한다. 화면은 편집기 없이 이 JSON 을 그린다(components/post/PostBody).
  doc          Json?
  /// 문서 형식 판 — 나중에 형식이 바뀌면 이걸로 가른다
  docVersion   Int           @default(1)
  /// 동영상 주소(우리 저장소만) — 문서 속 순서(서버가 뽑는다). 사진과 나눠 둔다: `images[0]` 이 목록 표지라 동영상이 끼면 안 된다.
  /// 파일 정리(lib/postAssets.ts)가 사진과 똑같이 이 목록을 보고 '아직 쓰는 파일'을 가린다
  videos       String[]      @default([])
  /// 투표(한 글에 하나, 2026-11-13) — `{ question, options:[{id,text}], multiple, endsAt }`. 문서의 `poll` 블록에서 서버가 뽑는다.
  /// 표는 PostPollVote. ⚠️ 표가 생긴 뒤에는 질문·보기·복수 선택을 못 바꾼다(lib/postPoll.ts) — 고르고 나서 보기가 바뀌면 그 표는 거짓말이 된다
  poll         Json?
  /// 목록 요약(리드) — 문서 글의 맨 바깥 문단들(lib/postDoc.ts postDocLede). 등록·수정 때 만든다. null 이면 body 앞부분(옛 글)
  excerpt      String?
  // 글마다 실명(닉네임+역할)/익명 선택 — true 면 응답에서 작성자 신원을 가린다
  anonymous    Boolean       @default(false)
  // 랭킹·목록을 매번 집계하지 않으려고 비정규화해서 들고 있는다
  likeCount    Int           @default(0)
  commentCount Int           @default(0)
  viewCount    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  comments  PostComment[]
  likes     PostLike[]
  draft     PostDraft?
  pollVotes PostPollVote[]

  @@index([createdAt])
  @@index([likeCount])
  @@index([categoryId])
  @@index([pinnedAt])
  @@index([authorId])
}

/// 커뮤니티 글 **작업본** (2026-11-13) — 쓰는 중인 새 글(postId 없음)과 고치는 중인 글(postId 있음).
/// ⚠️ 공개 응답에 절대 싣지 않는다 — 그래서 Post 의 칸이 아니라 따로 둔다(쓰다 만 글이 `...post` 한 번에 새지 않게).
/// 자동 저장은 `rev` 로 다른 기기·탭과의 충돌을 가른다(같은 rev 에서만 쓴다 — 아니면 409).
model PostDraft {
  id         Int           @id @default(autoincrement())
  authorId   Int
  author     User          @relation("postDraftAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  /// 고치는 중인 글. null 이면 아직 안 올린 새 글. 글 하나에 작업본 하나
  postId     Int?          @unique
  post       Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  categoryId Int?
  category   PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  anonymous  Boolean       @default(false)
  title      String        @default("")
  doc        Json
  /// 문서 속 사진·동영상 주소(서버가 뽑는다) — 파일을 지워도 되는지 볼 때 쓴다
  images     String[]      @default([])
  videos     String[]      @default([])
  /// 저장할 때마다 +1
  rev        Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([authorId, updatedAt])
}

/// 글쓰기 화면에서 올린 사진 (2026-11-13) — 파일 정리(이 사람이 글에 올린 것만 지운다)와 사진 치수.
/// ⚠️ 글 삭제 때 `images` 를 그대로 지우지 말 것 — API 로 남의 작품 사진 주소를 넣은 글을 지우면 **남의 파일**이 지워진다.
///    여기 적힌 것(그 사람이 글쓰기로 올린 것)만, 다른 글·작업본이 안 쓸 때만 지운다.
model PostAsset {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  userId    Int
  user      User     @relation("postAssets", fields: [userId], references: [id], onDelete: Cascade)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// 커뮤니티 필진 (2026-11-13) — `writePolicy: 'writers'` 탭에 글을 쓸 수 있는 회원. 관리자가 정한다(역할 무관).
model CommunityWriter {
  userId    Int      @id
  user      User     @relation("communityWriter", fields: [userId], references: [id], onDelete: Cascade)
  addedById Int?
  createdAt DateTime @default(now())
}

model PostComment {
  id        Int           @id @default(autoincrement())
  postId    Int
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User          @relation("postCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  anonymous Boolean       @default(false)
  /// 대댓글(2026-11-13) — 한 단계만. 답글의 답글도 맨 위 댓글(parentId)에 붙고, 누구에게 단 답인지는 replyToId
  parentId  Int?
  parent    PostComment?  @relation("commentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("commentThread")
  replyToId Int?
  replyTo   PostComment?  @relation("commentReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  repliedBy PostComment[] @relation("commentReplyTo")
  /// 답글이 달린 댓글을 지우면 자리만 남긴다("삭제된 댓글입니다") — 지우면 답글이 맥락 없이 남는다
  deletedAt DateTime?
  createdAt DateTime      @default(now())

  @@index([postId, createdAt])
  @@index([parentId])
}

/// 투표 한 표 — 사람 × 보기. 단일 선택이면 한 사람에 한 줄(서버가 바꿔 넣는다). 누가 무엇을 골랐는지는 응답에 싣지 않는다(내 표만)
model PostPollVote {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("postPollVoter", fields: [userId], references: [id], onDelete: Cascade)
  optionId  String
  createdAt DateTime @default(now())

  @@unique([postId, userId, optionId])
  @@index([postId, optionId])
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("postLiker", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

// 갤러리 모델
model Gallery {
  id                      Int       @id @default(autoincrement())
  name                    String
  address                 String
  phone                   String
  description             String
  detailDesc              String? // 상세 소개 (승인 후 수정 가능)
  region                  String // SEOUL, GYEONGGI_NORTH, GYEONGGI_SOUTH, DAEJEON, BUSAN
  // 별점 평균 — 2026-09-10 이후로 **갱신하지 않는다**(리뷰에서 별점을 없앴다).
  // 옛 값이 그대로 남은 **동결된 레거시**다. 화면 어디에서도 읽지 말 것 —
  // 새 리뷰가 쌓일수록 실제와 멀어지는 숫자라, 다시 표시하면 곧 거짓말이 된다.
  rating                  Float     @default(0)
  // 리뷰 개수 — 별점과 무관하게 계속 갱신한다('리뷰 N개' 표시와 '리뷰 없음' 판정에 쓴다)
  reviewCount             Int       @default(0)
  viewCount               Int       @default(0) // 상세 페이지 조회수 (Admin 통계용, 비-관리자/비-소유자 조회 시 증가)
  status                  String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectReason            String?
  /// 관리자가 승인·거절한 때(2026-11-21, [승인 관리] 처리한 요청 · 통계 운영 속도) — 그 전 결정은 승인 알림 시각으로 채웠다(없으면 null)
  reviewedAt   DateTime?
  ownerName               String
  mainImage               String?
  instagramUrl            String? // 인스타그램 주소 (@handle) — 연동 시 저장, 연결 해제 전까지 유지
  instagramAccessToken    String? // Instagram 장기 액세스 토큰(60일, 서버 전용) — OAuth로 발급
  instagramTokenExpiresAt DateTime? // 장기 토큰 만료 시각 — 만료 임박 시 갱신
  instagramFeedVisible    Boolean   @default(false) // 피드 공개 여부
  instagramProfileVisible Boolean   @default(false) // 프로필 링크 공개 여부
  email                   String? // 갤러리 이메일 주소
  /// 갤러리 페이지 '함께한 작가'(이 갤러리 공모에 수락된 작가)에서 **숨긴** 작가 id (2026-09-16).
  /// 자동 집계라 갤러리가 특정 작가를 빼고 싶을 수 있다. 빈 배열이 기본. 응답에는 싣지 않는다(artists[].hidden 으로).
  hiddenArtistIds         Int[]     @default([])
  /// 갤러리 홈페이지 주소 `/@handle` (2026-09-16). **`User.handle` 과 같은 이름 공간**을 쓴다 —
  /// `/@x` 하나로 작가·갤러리를 다 가리키므로 양쪽에 같은 값이 있으면 안 된다(lib/handle.ts `handleTaken`).
  /// 갤러리는 상호가 한글이라 자동 생성을 하지 않는다 — 주인이 직접 정한다. 숫자 주소 `/galleries/:id` 는 계속 유효.
  handle                  String?   @unique
  /// 관람 시간 — 자유 글 80자("화–일 11:00–18:00 · 월 휴관", 2026-11-14 홈페이지 개편). 갤러리 페이지 방문 정보 맨 위.
  /// 자유 글이라 '지금 열려 있어요' 같은 판정은 하지 않는다(틀린 표시는 없는 것보다 나쁘다).
  openHours               String?
  /// 로그인하지 않은 방문자의 문의(이름·연락처·내용)를 받는가 — 기본 꺼짐. 켜야 갤러리 페이지 [문의하기]에 비회원 입력 칸이 열린다(HomepageInquiry)
  guestInquiry            Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  ownerId            Int
  owner              User                @relation(fields: [ownerId], references: [id])
  homepageInquiries  HomepageInquiry[]
  images             GalleryImage[]
  archives           GalleryArchive[]
  exhibitions        Exhibition[]
  managedExhibitions ExhibitionManager[] // 아트링크 주최 공모 중 이 갤러리가 운영을 위임받은 것
  shows              Show[]
  reviews            Review[]
  favorites          Favorite[]
  galleryOfMonth     GalleryOfMonth?

  @@index([ownerId])
  @@index([status, region])
  @@index([rating])
}

// 갤러리 이미지
model GalleryImage {
  id        Int     @id @default(autoincrement())
  url       String
  order     Int     @default(0)
  galleryId Int
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
}

// 공모 사진 (다중, 순서변경 가능) — 첫 사진(order 최소)이 대표 이미지로 imageUrl과 동기화
model ExhibitionImage {
  id           Int        @id @default(autoincrement())
  url          String
  order        Int        @default(0)
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

  @@index([exhibitionId])
}

// 전시/공모 모델
model Exhibition {
  id                    Int       @id @default(autoincrement())
  title                 String
  type                  String // SOLO, GROUP, ART_FAIR
  deadline              DateTime // 공모 마감일
  deadlineStart         DateTime? // 공모 시작일
  exhibitDate           DateTime? // 전시 종료일 — ⚠️ 공모만 진행(recruitOnly)이면 전시가 없으므로 null (2026-09-19)
  exhibitStartDate      DateTime? // 전시 시작일
  capacity              Int // 수락(선정) 한도 — 0명 공고면 9, 00명이면 99 (lib/capacity.ts)
  capacityMask          String? // 공고에 적는 모집 인원: NULL = 숫자 그대로 · 'ONE' = 0명 · 'TWO' = 00명 (2026-10-14)
  region                String
  description           String
  imageUrl              String? // 공모 대표 이미지
  customFields          String? // 커스텀 질문 항목 (JSON 문자열: [{id, label, type, required, options}])
  viewCount             Int       @default(0) // 상세 페이지 조회수 (Admin 통계용, 비-관리자/비-소유자 조회 시 증가)
  status                String    @default("PENDING") // PENDING, APPROVED, REJECTED (승인 상태)
  rejectReason          String?
  /// 관리자가 승인·거절한 때(2026-11-21) — 아트링크 주최(등록 즉시 게시)는 null
  reviewedAt   DateTime?
  hostType              String    @default("GALLERY") // GALLERY(갤러리 주최, 기본) | ADMIN(아트링크 주최 — 운영은 managers 갤러리들에게 위임)
  // 공모만 진행할 것인가 (2026-09-10).
  //   false(기본) — 지원 → 수락 → 자료제출 → 전시 → 정산 까지 전부 (지금까지의 동작)
  //   true         — **수락까지가 끝**. 자료제출·확정·전시종료·판매·정산 단계가 아예 없다.
  // 기본값 false 라 기존 공모는 전부 그대로다. 판정은 반드시 lib/exhibitionStage.ts 를 거칠 것.
  recruitOnly           Boolean   @default(false)
  // 작가가 출품자료(출품리스트·약력·노트)를 내야 하는 마감일. 지원마감 < 이 날짜 < 전시시작.
  // 신규 등록은 필수지만, 2026-08-19 이전에 올라간 공모는 값이 없어 nullable 이다
  // (갤러리가 공모 상세에서 한 번 채워 넣고, 그 뒤로는 Admin 만 고칠 수 있다).
  // ⚠️ `recruitOnly` 공모에는 자료제출 단계가 없으므로 **등록 때 받지 않는다**(항상 null).
  submissionDeadline    DateTime?
  // 선정 마감일 (2026-11-21, CLAUDE.md 규칙 90) — 갤러리는 접수가 끝난 뒤 이날까지 수락한다. 이날이 지나면 수락하지 않은 지원은
  // **알림 없이** 미선정이 되고 더는 수락할 수 없다(lib/selectionDeadline.ts). 접수 마감 다음 날 ~ 출품 자료 마감 전날.
  // **새로 올리는 공고부터 필수** — 그 전에 올라간 공고는 null 로 둔다(사용자 결정). 그런 공고는 [선정 마치기]·전시 확정·종료 때 선정이 끝난다.
  // 지나기 전까지 갤러리가 고칠 수 있다(`PATCH /exhibitions/:id/selection-deadline`).
  selectionDeadline     DateTime?
  recruitmentClosed     Boolean   @default(false) // 모집마감 (수동 내림 → 목록 비노출)
  confirmed             Boolean   @default(false) // 확정 (작가 전시정보 수정 잠금). 전시 시작일 경과 시 자동 확정 처리
  ended                 Boolean   @default(false) // 전시종료 (정산 단계)
  settlementRequestedAt DateTime? // 정산 확인 요청 시각. non-null=작가 확인 대기(정산 수정 잠금 + 작가에게 검토 공개)
  settledAt             DateTime? // 정산 완료 시각. non-null=정산 확정(운영페이지 수정 잠금 + 작가에게 정산 공개)
  // 카드 결제 수수료율(%). 카드로 팔린 작품 합계에서 먼저 떼고 남은 금액을 갤러리:작가 비율로 나눈다.
  // 현금 판매분에는 붙지 않는다. 0이면 예전과 완전히 같은 계산(기본값) — lib/settlementFingerprint.ts 참고.
  cardFeeRate           Float     @default(0)
  /// 첨부파일 (2026-10-08) — 모집 요강·지원서 양식 등. `[{ url, name, size }]`, 공고당 10개까지. **누구나**(비회원 포함) 공고 상세에서 내려받는다.
  /// 쓰고 읽을 땐 반드시 `lib/exhibitionAttachments.ts` 를 거칠 것 — 우리 저장소 주소만 받고, 이상한 값은 읽을 때 건너뛴다.
  attachments           Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // 주관 갤러리. **아트링크(Admin) 주최 공모는 갤러리를 아예 안 낄 수 있어 nullable 이다**(2026-09-10).
  // ⚠️ 갤러리 주최 공모(hostType='GALLERY')에는 **항상 값이 있다** — 라우트가 그렇게 강제한다.
  //    null 을 만들 수 있는 경로는 `POST /exhibitions/hosted` 와 `PATCH /:id/managers` 둘뿐이고,
  //    둘 다 Admin 전용 + hostType='ADMIN' 검사를 거친다.
  // ⚠️ 읽는 쪽은 반드시 `gallery?.` 로 볼 것 — 옛 코드가 `exhibition.gallery.name` 처럼 바로 꺼내고 있었다.
  galleryId           Int?
  gallery             Gallery?               @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  managers            ExhibitionManager[]
  applications        Application[]
  favorites           Favorite[]
  promoPhotos         PromoPhoto[]
  images              ExhibitionImage[]
  messages            Message[]
  reviews             Review[]
  notices             ExhibitionNotice[]
  submissions         ExhibitionSubmission[]
  sales               ArtworkSale[]
  attachmentHits ExhibitionAttachmentHit[]
  settlements         ArtistSettlement[]
  settlementApprovals SettlementApproval[]
  invites             ExhibitionInvite[]
  chat                Chat?
  joinCode            ExhibitionJoinCode?

  @@index([galleryId])
  @@index([status, deadline])
  @@index([region])
}

// 아트링크(Admin) 주최 공모의 운영 갤러리 — 이 갤러리 오너는 해당 공모를 소유 갤러리처럼 운영할 수 있다.
//
// ⚠️ hostType='ADMIN' 인 공모에서만 의미가 있다. 갤러리가 직접 등록한 공모(hostType='GALLERY')에는
//    행을 만들지 않고, 권한 판정에서도 hostType 을 먼저 확인한다(lib/exhibitionAccess.ts).
//    "운영 위임은 아트링크가 주최할 때만" 이라는 규칙을 데이터와 코드 양쪽에서 지키기 위함.
//
// galleryId 는 여전히 필수(주관 갤러리)이며 반드시 이 목록에 함께 들어간다 —
// 목록 카드·정산·통계 등 기존 코드 전부가 exhibition.gallery 를 전제로 하기 때문이다.
model ExhibitionManager {
  id           Int        @id @default(autoincrement())
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  galleryId    Int
  gallery      Gallery    @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([exhibitionId, galleryId])
  @@index([galleryId])
}

// 전시 종료 후 홍보 사진
model PromoPhoto {
  id           Int        @id @default(autoincrement())
  url          String
  caption      String?
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

// 히어로 슬라이드
model HeroSlide {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  imageUrl       String
  // 좁은 화면(모바일) 전용 이미지. 3:1 배너는 375px 에서 높이 125px 로 줄어 안에 든 글씨가 안 읽히므로
  // 세로형(4:5 권장)을 따로 받는다. 없으면 imageUrl 을 그대로 쓴다(2026-09-16).
  mobileImageUrl String?
  linkUrl        String?
  // 사진 위 글자 색 고정(2026-10-05). null = 자동(글자가 놓인 자리의 밝기로 검정/흰색, frontend lib/heroTone.ts),
  // 'black' · 'white' = 관리자가 고정 — 자동이 사진 속 그림(연필 등)에 걸려 틀릴 때 쓴다
  textTone       String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 혜택
model Benefit {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  linkUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 이달의 갤러리
model GalleryOfMonth {
  id        Int      @id @default(autoincrement())
  galleryId Int      @unique
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  title     String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// 리뷰
model Review {
  id        Int      @id @default(autoincrement())
  // 별점 — 2026-09-10 부터 **받지 않는다**(사용자 요청으로 리뷰에서 별점을 없앴다).
  // ⚠️ 컬럼을 지우지 않고 nullable 로만 바꿨다. 그 전에 쓰인 점수는 실제 사용자가 남긴 기록이라
  //    되돌릴 수 없게 지울 이유가 없다. 신규 리뷰는 null 이고 화면 어디에도 표시하지 않는다.
  //    다시 켜려면 이 필드를 필수로 되돌리고 Gallery.rating 재계산을 살리면 된다.
  rating    Int? // 1-5 (레거시 — 신규 리뷰는 null)
  content   String
  imageUrl  String?
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId       Int
  user         User        @relation(fields: [userId], references: [id])
  galleryId    Int
  gallery      Gallery     @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  exhibitionId Int?
  exhibition   Exhibition? @relation(fields: [exhibitionId], references: [id], onDelete: SetNull)

  @@index([galleryId])
  @@index([userId])
}

// 찜하기
model Favorite {
  id           Int         @id @default(autoincrement())
  userId       Int
  user         User        @relation(fields: [userId], references: [id])
  galleryId    Int?
  gallery      Gallery?    @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  exhibitionId Int?
  exhibition   Exhibition? @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  showId       Int?
  show         Show?       @relation(fields: [showId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@unique([userId, galleryId])
  @@unique([userId, exhibitionId])
  @@unique([userId, showId])
  @@index([userId])
  // 역방향 조회/부모 삭제(cascade) 시 seq scan 방지
  @@index([galleryId])
  @@index([exhibitionId])
  @@index([showId])
}

// 포트폴리오
model Portfolio {
  id                Int                @id @default(autoincrement())
  biography         String?
  exhibitionHistory String? // (구) 전시이력 단일 텍스트 — career로 대체, 하위호환 위해 컬럼 유지
  career            String? // 경력 JSON: { artFair:[{year,content}], solo:[...], group:[...], education?, award? }
  portfolioFileUrl  String? // 포트폴리오 파일(pdf/doc/hwp) URL
  statement         String? // 작가노트(ARTIST STATEMENT) — 약력(biography)과 별개. 갤러리가 가장 먼저 읽는 글
  tagline           String? // 한 줄 소개 — 포맷 PDF 표지 부제
  themeId           String? // 마지막으로 고른 포트폴리오 포맷 (gallery|studio|story|archive)
  seriesInfo        String? // 시리즈 설명 JSON: [{ name, note }]
  designConfig      String? // 가이드형 디자인 JSON: { theme, works, sections:[{id,enabled}] }. null=기본(현재 모습)
  /// 홈페이지에 작품 가격을 보이는가(2026-10-15, 기본 꺼짐) — 켜도 판매완료·비매 작품은 안 보인다. PDF 는 designConfig.showPrice 가 따로 정한다
  showPrice         Boolean            @default(false)
  /// 홈페이지 이름 위에 프로필 사진(User.avatar)을 보이는가(2026-10-28, 기본 꺼짐) — 카카오 가입이면 카카오 프로필 사진이 들어 있어 작가가 고를 때만 보인다
  showAvatar        Boolean            @default(false)
  /// 로그인하지 않은 방문자의 문의(이름·연락처·내용)를 받는가(2026-11-14, 기본 꺼짐) — 켜야 홈페이지 [문의하기]에 비회원 입력 칸이 열린다(HomepageInquiry)
  guestInquiry      Boolean            @default(false)
  userId            Int                @unique
  user              User               @relation(fields: [userId], references: [id])
  images            PortfolioImage[]
  versions          PortfolioVersion[]
  updatedAt         DateTime           @updatedAt
}

/// 포트폴리오 PDF **버전** — 작품 선택·순서·디자인을 묶어 이름 붙여 저장 (2026-09-16).
/// "공모용 10점"·"갤러리용 전체" 처럼 보내는 곳마다 다른 책을 만든다(국내 공모는 A4 24장·이미지 10점 같은 장수 제한이 흔하다).
/// 홈페이지의 작품 순서(`PortfolioImage.order`)는 건드리지 않는다 — 버전은 그 위에 얹는 **선택**이다.
model PortfolioVersion {
  id          Int       @id @default(autoincrement())
  portfolioId Int
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  name        String
  /// 실을 작품 id, 실릴 순서대로. 빈 배열이면 전체 작품을 홈페이지 순서로.
  workIds     Int[]     @default([])
  /// PdfDesign JSON. null 이면 Portfolio.designConfig(기본 디자인)를 쓴다.
  design      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([portfolioId])
}

// 포트폴리오 이미지
model PortfolioImage {
  id            Int                  @id @default(autoincrement())
  url           String
  /// 사진의 실제 픽셀 크기 — 업로드 때 sharp 로 잰다(lib/imageDims.ts). 배치(정렬 격자·PDF·ArtLook)가 비율을
  /// 미리 알아야 화면이 안 튄다. 옛 행은 `scripts/backfill-image-dims.ts`(Render 셸). null 이면 화면이 로드 후 잰다.
  width         Int?
  height        Int?
  order         Int                  @default(0)
  showInExplore Boolean              @default(false)
  // ── 작품 정보 ──
  // 실제 작가 포트폴리오는 예외 없이 [제목/재료/크기/제작연도]를 작품마다 붙인다(샘플 5종 전부).
  // 없으면 캡션이 통째로 빠지므로 전부 nullable — 있는 항목만 조립한다(lib/artwork.ts).
  title         String?
  medium        String? // 재료 (예: Acrylic on canvas)
  sizeText      String? // 크기 (예: 72.7 × 90.9 cm) — 자유 텍스트
  year          String? // 제작연도
  series        String? // 시리즈명 — 포맷 PDF에서 이 값으로 묶고 시리즈 표지를 만든다
  description   String? // 작품 설명 / 서사
  status        String? // AVAILABLE | SOLD | NFS(비매) — null이면 표기 안 함
  /// 가격 — **별도 표**(ArtworkPrice). 이 행에 컬럼으로 두면 작품 행을 통째로 내려주는 공개 응답에 그대로 실린다
  price         ArtworkPrice?
  portfolioId   Int
  portfolio     Portfolio            @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  likes         PortfolioImageLike[]
  scraps        ArtworkScrap[]
}

// 포트폴리오 이미지 좋아요
model PortfolioImageLike {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageId   Int
  image     PortfolioImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, imageId])
  @@index([imageId])
  @@index([userId])
}

// 지원
model Application {
  id               Int        @id @default(autoincrement())
  userId           Int
  user             User       @relation(fields: [userId], references: [id])
  exhibitionId     Int
  exhibition       Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  customAnswers    String? // (구) 커스텀 질문 답변 — 고정 양식으로 대체, 하위호환 위해 컬럼 유지
  biography        String? // 지원 시 작가 약력 (필수)
  career           String? // 지원 시 경력 JSON: { artFair:[{year,content}], solo:[...], group:[...] }
  artworkImages    String? // 지원 시 작품 사진 URL 배열 JSON (최대 10, 1장 이상 필수)
  portfolioFileUrl String? // 지원 시 포트폴리오 파일(pdf/doc/hwp) URL
  termsAgreedAt    DateTime? // 작가 지원 약관 동의 시각
  termsVersion     String? // 동의한 작가 지원 약관 버전
  termsTextHash    String? // 동의한 약관 전문의 해시(SHA-256)
  status           String     @default("SUBMITTED") // SUBMITTED, REVIEWED, ACCEPTED, REJECTED
  rejectionAckedAt DateTime? // 거절을 작가가 '확인'한 시각. non-null이면 지원내역 목록에서 숨김
  // 어떻게 들어왔나(2026-09-27) — null = 지원서를 내서, 'INVITE' = 1:1 초대 수락, 'CODE' = 초대 코드 입력.
  // 갤러리 지원자 목록이 '코드 참여' 배지를 단다. 그 전의 초대 수락 행은 null 로 남아 있다(소급하지 않는다).
  joinedVia        String?
  // 모집 마감 때 검토 대기라 미선정이 된 시각(2026-11-21) — 갤러리가 직접 거절한 것과 가른다('모집 마감 때'). 다시 수락하면 비운다.
  // 작가에게는 알리지 않는다(사용자 결정 — 작가 화면에서 미선정으로 보이면 된다). lib/applicationWindow.ts
  closedOutAt      DateTime?
  // 작가가 낸 지원서를 마지막으로 고친 시각(2026-11-21) — 갤러리 지원자 목록의 '11.22 수정'. 검토 대기 · 모집 중에만 고친다
  editedAt         DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt // 상태 변경(수락/거절 등) 시각 추적

  @@unique([userId, exhibitionId])
  @@index([userId])
  // 지원마다 실행되는 정원 count + 지원자 목록이 exhibitionId로 필터 → 인덱스 필요
  @@index([exhibitionId])
}

// 전시 (갤러리의 실제 전시/행사 소개)
model Show {
  id           Int         @id @default(autoincrement())
  title        String
  description  String
  startDate    DateTime
  endDate      DateTime
  openingHours String // "10:00-18:00"
  admissionFee String // "무료" or "5,000원"
  location     String
  region       String // SEOUL, GYEONGGI_NORTH 등 (필터용)
  artists      String? // JSON: ["작가1","작가2"]
  posterImage  String
  viewCount    Int         @default(0) // 상세 페이지 조회수 (Admin 통계용, 비-관리자/비-소유자 조회 시 증가)
  status       String      @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectReason String?
  /// 관리자가 승인·거절한 때(2026-11-21)
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  galleryId    Int
  gallery      Gallery     @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  images       ShowImage[]
  favorites    Favorite[]

  @@index([galleryId])
  @@index([status, region])
}

// 전시 추가 이미지
model ShowImage {
  id     Int    @id @default(autoincrement())
  url    String
  order  Int    @default(0)
  showId Int
  show   Show   @relation(fields: [showId], references: [id], onDelete: Cascade)
}

// 인앱 알림
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // APPLICATION_STATUS, NEW_APPLICANT, APPROVAL_RESULT, ARTWORK_LIKE, EXHIBITION_INVITE
  message   String
  linkUrl   String?
  refKey    String? // 집계용 키(예: "artwork-like:123") — 같은 대상의 알림을 새로 쌓지 않고 갱신하는 데 사용
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
  @@index([userId, refKey])
}

/// 안드로이드 앱(mobile/)의 푸시 알림 기기 토큰 (2026-11-09, CLAUDE.md 규칙 79).
/// 홈페이지 문의 — **로그인하지 않은 방문자**가 작가·갤러리 홈페이지의 [문의하기]로 남긴 글 (2026-11-14, CLAUDE.md 규칙 82).
/// 로그인한 회원의 문의는 ArtTalk(갠톡)으로 간다 — 여기는 비회원 전용이고, 받는 사람이 켰을 때만 열린다(Portfolio/Gallery.guestInquiry).
/// ⚠️ 1:1 문의(고객센터, `Inquiry`)와 다른 것이다 — 코드·화면에서 '홈페이지 문의'로 부른다.
/// 개인정보(이름·연락처)라 **1년 뒤 지운다**(lib/homepageInquiry.ts 의 pruneHomepageInquiries) · 받은 사람이 지우면 바로 지운다 · 받은 사람이 탈퇴하면 함께 지운다.
model HomepageInquiry {
  id        Int       @id @default(autoincrement())
  /// 받는 사람(작가 본인 또는 갤러리 주인)
  ownerId   Int
  owner     User      @relation("homepageInquiryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// 갤러리 페이지에서 온 문의면 그 갤러리(갤러리가 지워져도 문의는 받은 사람에게 남는다)
  galleryId Int?
  gallery   Gallery?  @relation(fields: [galleryId], references: [id], onDelete: SetNull)
  /// 작품 페이지에서 온 문의면 그 작품 — FK 를 두지 않는다(작품을 지워도 문의는 남아야 한다). 이름은 보낸 때의 것을 따로 둔다
  imageId   Int?
  workTitle String?
  name      String
  contact   String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([ownerId, createdAt])
  @@index([createdAt])
}

/// 벨 알림(Notification)이 생기면 그 사람의 기기들로 보낸다(lib/push.ts — Prisma 미들웨어 한 곳에서, 알림 만드는 34곳은 그대로).
/// token 이 unique — 같은 기기에서 다른 사람이 로그인하면 줄의 userId 가 바뀐다(upsert). 로그아웃하면 지운다(토큰이 곧 자격 — 인증 없이).
/// FCM 이 '등록 해제됨'이라고 답한 토큰은 보내면서 지운다.
model PushToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String // 'android' | 'ios'
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// 자주 묻는 질문 (Admin 작성, 전체 공개)
model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  order     Int      @default(0)
  category  String   @default("GENERAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 1:1 문의
model Inquiry {
  id        Int       @id @default(autoincrement())
  subject   String
  content   String
  status    String    @default("OPEN") // OPEN, ANSWERED
  reply     String?
  repliedAt DateTime?
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

// 승인 요청 (갤러리/공모 수정 요청)
model ApprovalRequest {
  id           Int      @id @default(autoincrement())
  type         String // GALLERY_EDIT, EXHIBITION_EDIT
  targetId     Int // galleryId or exhibitionId
  changes      String // JSON string of requested changes
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectReason String?
  /// 관리자가 처리한 때(2026-11-21) — 그 전 기록은 updatedAt 으로 채웠다
  decidedAt    DateTime?
  requesterId  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// 메시지 (Artist ↔ Gallery 소통)
model Message {
  id           Int             @id @default(autoincrement())
  subject      String
  content      String
  read         Boolean         @default(false)
  senderId     Int
  sender       User            @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId   Int
  receiver     User            @relation("receivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  exhibitionId Int?
  exhibition   Exhibition?     @relation(fields: [exhibitionId], references: [id], onDelete: SetNull)
  attachments  String?
  createdAt    DateTime        @default(now())
  reports      MessageReport[]

  @@index([receiverId, read])
  @@index([senderId])
  @@index([exhibitionId])
  @@index([createdAt])
}

// 메시지 신고
model MessageReport {
  id         Int      @id @default(autoincrement())
  messageId  Int
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId Int
  reporter   User     @relation("messageReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  detail     String?
  status     String   @default("PENDING")
  adminNote  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([messageId, reporterId])
  @@index([status])
  @@index([createdAt])
}

// 공모 운영 페이지 — 갤러리 공지사항
model ExhibitionNotice {
  id           Int        @id @default(autoincrement())
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  title        String
  content      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  @@index([exhibitionId])
}

// 공모 운영 페이지 — 수락 작가가 제출하는 전시 정보 (출품리스트/작가약력/작가노트)
model ExhibitionSubmission {
  id                  Int        @id @default(autoincrement())
  exhibitionId        Int
  exhibition          Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  userId              Int
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  artworkList         String? // JSON: [{image,title,size,medium,year,price}]
  cv                  String? // JSON: {nameKo,nameEn,birth,tel,email,education[],solo[],group[],artFair[],award[]} (각 항목 [{year,content}])
  note                String? // JSON: {statement, sections:[{title,body}]}
  representativeIndex Int? // 엽서용 대표작 — artworkList 내 인덱스 (작가가 선택, null=미선택)
  // 마지막으로 저장한 사람. null 이거나 userId 와 같으면 작가 본인이 쓴 것,
  // 다르면 갤러리/Admin 이 대신 입력한 것이다(자료 업로드가 어려운 작가를 돕는 경로).
  // 작가가 나중에 직접 고치면 다시 본인 id 로 덮여 '대신 입력' 표시가 사라진다.
  updatedById         Int?
  updatedBy           User?      @relation("submissionEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt           DateTime   @default(now()) @updatedAt

  @@unique([exhibitionId, userId])
  @@index([exhibitionId])
}

// 판매된 작품 (전시종료 후 갤러리가 입력) — 작가 출품리스트의 index 기준
model ArtworkSale {
  id            Int        @id @default(autoincrement())
  exhibitionId  Int
  exhibition    Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  artistUserId  Int
  artist        User       @relation("artworkSales", fields: [artistUserId], references: [id], onDelete: Restrict)
  artworkIndex  Int // 해당 작가 artworkList 내 인덱스
  title         String // 작품명 스냅샷
  soldPrice     Int // 판매가 (원)
  paymentMethod String     @default("CARD") // CARD(카드) | CASH(현금)

  @@unique([exhibitionId, artistUserId, artworkIndex])
  @@index([exhibitionId])
  @@index([artistUserId])
}

// 작가별 정산 비율 (전시종료 후 갤러리가 입력) — galleryRatio: 갤러리 몫 %, 작가 = 100 - galleryRatio
model ArtistSettlement {
  id           Int        @id @default(autoincrement())
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  artistUserId Int
  artist       User       @relation("artistSettlements", fields: [artistUserId], references: [id], onDelete: Restrict)
  galleryRatio Int        @default(0) // 0~100

  @@unique([exhibitionId, artistUserId])
  @@index([exhibitionId])
  @@index([artistUserId])
}

// 정산 확인 승인 — 갤러리가 [정산 확인 요청] 시 수락 작가별 1행 생성. 전원 APPROVED여야 갤러리가 정산 완료 가능.
model SettlementApproval {
  id             Int        @id @default(autoincrement())
  exhibitionId   Int
  exhibition     Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  artistUserId   Int
  artist         User       @relation("settlementApprovals", fields: [artistUserId], references: [id], onDelete: Restrict)
  status         String     @default("PENDING") // PENDING(미응답) | APPROVED(수락) | ISSUE(문제제기)
  comment        String? // 문제 제기 시 갤러리에 전달할 코멘트
  // 응답 당시 정산 금액의 지문(lib/settlementFingerprint.ts). 갤러리가 이 작가 금액을 고치면
  // 지문이 어긋나 자동으로 PENDING 으로 되돌아간다 → 금액이 그대로인 작가는 수락이 유지된다.
  // null = 옛 데이터/미응답. 옛 APPROVED 행은 첫 저장 때 한 번 재확인 대상이 된다(안전한 방향).
  snapshot       String?
  // 이 작가에게 **마지막으로 물어본** 시각. 무응답 자동 수락 기한의 기준점이라
  // PENDING 으로 만들 때마다(최초 요청·작가별 재요청·금액 수정으로 인한 초기화) 새로 찍는다.
  // null = 옛 데이터 → 자동 수락 대상이 아니다(경고를 못 받은 사람에게 소급 적용하지 않는다).
  askedAt        DateTime?
  // 무응답으로 자동 수락된 시각. 사람이 직접 누른 수락과 반드시 구분돼야 한다 — 돈 문제라
  // 나중에 "동의한 적 없다"는 다툼이 생기면 이 값이 유일한 근거다.
  autoApprovedAt DateTime?
  updatedAt      DateTime   @default(now()) @updatedAt

  @@unique([exhibitionId, artistUserId])
  @@index([exhibitionId])
  @@index([artistUserId])
}

// 앱 전역 설정 (key-value) — Admin 개발자 도구 토글 등 런타임 플래그 영속화
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// 갤러리의 비공개 스카우팅 보드 — 둘러보기에서 마음에 든 작품을 저장(작가에게 노출되지 않음)
model ArtworkScrap {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation("artworkScraps", fields: [userId], references: [id], onDelete: Cascade)
  imageId   Int
  image     PortfolioImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  memo      String? // 갤러리만 보는 메모
  createdAt DateTime       @default(now())

  @@unique([userId, imageId])
  @@index([userId])
}

// 갤러리 → 작가 공모 초대 (초대일 뿐 자동 지원 아님 — 작가가 직접 지원해야 한다)
model ExhibitionInvite {
  id           Int        @id @default(autoincrement())
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  artistId     Int
  artist       User       @relation("invitesReceived", fields: [artistId], references: [id], onDelete: Cascade)
  senderId     Int
  sender       User       @relation("invitesSent", fields: [senderId], references: [id], onDelete: Cascade)
  message      String?
  status       String     @default("SENT") // SENT(전송) | APPLIED(지원함) | DECLINED(작가가 숨김)
  createdAt    DateTime   @default(now())

  @@unique([exhibitionId, artistId])
  @@index([artistId, status])
  @@index([exhibitionId])
}

// ===== Admin 전용 할 일 보드 (회의 내용·할 일 정리) =====
// 공개 API 없음. 모든 라우트가 authorize('ADMIN') 뒤에 있다 — 보드 제목·항목 본문·댓글에
// 회의 내용이 그대로 들어가므로 역할 검증을 빼면 곧바로 내부 논의가 새어 나간다.
//
// 이름이 Kanban* 인 이유: 처음엔 3열 칸반으로 만들었다가 목록형 체크리스트로 바꿨다.
// 테이블명만 남았을 뿐 열(column) 개념은 없다 — 완료 여부는 doneAt 하나로 판정한다.

model KanbanBoard {
  id          Int          @id @default(autoincrement())
  title       String
  description String? // 보드 부제(무엇을 모아두는 보드인지)
  position    Int          @default(0) // 보드 목록 내 정렬 순서 (0부터 연속, 이동 시 서버가 재부여)
  createdById Int?
  createdBy   User?        @relation("kanbanBoardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  cards       KanbanCard[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([position])
}

model KanbanCard {
  id          Int             @id @default(autoincrement())
  boardId     Int
  board       KanbanBoard     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title       String
  body        String? // 회의 내용·상세 메모
  assigneeId  Int?
  assignee    User?           @relation("kanbanAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate     DateTime? // KST 달력 날짜 기준으로 판정 (lib/kstDate.ts)
  position    Int             @default(0) // 목록 순서 (0부터 연속, 재정렬 시 서버가 다시 부여)
  doneAt      DateTime? // 체크한 시각. null 이면 아직 안 한 일. 완료 판정은 이 값 하나뿐이다
  createdById Int?
  createdBy   User?           @relation("kanbanCardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments    KanbanComment[]
  subtasks    KanbanSubtask[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([boardId, position])
  @@index([assigneeId])
}

model KanbanComment {
  id        Int        @id @default(autoincrement())
  cardId    Int
  card      KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorId  Int? // 작성자가 하드 삭제돼도 회의 기록은 남긴다 (SetNull, 화면엔 '알 수 없음')
  author    User?      @relation("kanbanCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime   @default(now())

  @@index([cardId, createdAt])
}

// 항목 안의 세부항목(체크리스트). 목록 화면에 그대로 펼쳐 보이고 거기서 바로 체크한다.
//
// 상위 항목과 일부러 다르게 두 가지:
//   ① 담당자·마감일·댓글이 없다 — 그 정도로 무거운 일이면 상위 항목으로 올리는 게 맞다.
//   ② 체크해도 자리가 안 바뀐다(정렬도 position 순 그대로). 서너 줄짜리 목록에서 체크할 때마다
//      줄이 튀어 다니면 다음 걸 누르기가 힘들다.
model KanbanSubtask {
  id        Int        @id @default(autoincrement())
  cardId    Int
  card      KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title     String
  doneAt    DateTime? // 체크한 시각. null 이면 아직 안 한 일 (상위 항목과 같은 규약)
  position  Int        @default(0) // 적은 순서 (0부터 연속)
  createdAt DateTime   @default(now())

  @@index([cardId, position])
}

// ===== 대화 (갠톡 1:1 · 단톡 그룹) =====
//
// 예전 Message 모델은 sender/receiver 한 쌍의 '쪽지'라 단톡을 담을 수 없었고,
// "갤러리↔작가만" 같은 역할 제약이 라우트에 박혀 있어 작가끼리 대화도 못 했다.
// 여기서는 **누가 대화할 수 있는가를 '방에 들어가 있는가'로만** 판정한다 —
// 역할로 막지 않고, 방을 만드는 길목에서만 제한한다(아래).
//
// ⚠️ 임의 검색으로 아무에게나 말을 걸 수 있으면 안 된다. 방이 생기는 길은 둘뿐이다:
//    · 갠톡(DIRECT) — 둘러보기·작가 홈페이지에서 그 사람을 보고 시작
//    · 단톡(GROUP)  — 공모가 승인되면 자동 생성. 갤러리(+Admin 주최면 운영 갤러리)와
//                     수락된 작가가 자동으로 참여자가 된다
model Chat {
  id            Int               @id @default(autoincrement())
  kind          String // DIRECT(1:1) | GROUP(단톡)
  title         String? // 단톡 이름 (공모 제목). 갠톡은 상대 이름을 화면에서 만든다
  // 공모 단톡은 공모당 하나 — 유니크로 중복 생성을 막는다
  exhibitionId  Int?              @unique
  exhibition    Exhibition?       @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  // 갠톡 중복 방지 키 `min-max` (예: "12-45"). 그룹은 null.
  // 유니크 인덱스라 같은 두 사람의 방이 두 개 생기지 않는다.
  directKey     String?           @unique
  createdById   Int?
  createdBy     User?             @relation("chatCreator", fields: [createdById], references: [id], onDelete: SetNull)
  // 목록 정렬용. 메시지를 넣을 때 함께 갱신한다(매번 집계하면 목록이 느려진다)
  lastMessageAt DateTime          @default(now())
  // 단톡(공모방)이 작가에게 열린 시각 — 운영자(작가가 아닌 참여자)의 첫 메시지 때 적는다(2026-11-19, 카카오톡 단체방처럼).
  // null 이면 작가의 목록·주소 접근에서 빠진다(운영자에겐 보인다). 갠톡은 쓰지 않는다(빈 1:1 방은 메시지 유무로 거른다)
  openedAt      DateTime?
  participants  ChatParticipant[]
  messages      ChatMessage[]
  createdAt     DateTime          @default(now())

  @@index([lastMessageAt])
}

model ChatParticipant {
  id         Int       @id @default(autoincrement())
  chatId     Int
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 이 시각 **이후**에 온 메시지가 안 읽음이다. 메시지마다 읽음 행을 쌓지 않는 이유는
  // 단톡 20명 × 메시지 수만큼 행이 늘기 때문 — 시각 하나로 같은 답을 낼 수 있다.
  lastReadAt DateTime?
  // 이 방 알림 끄기(카카오톡 '알림 끄기' — 2026-11-11). 켜 두면 새 메시지가 벨 알림·앱 푸시로 오지 않는다.
  // 대화 목록의 안 읽은 수는 그대로 센다(조용히 쌓일 뿐 사라지지 않는다).
  muted      Boolean   @default(false)
  // 목록에서 숨김(2026-11-19, ArtTalk 개편). 숨긴 뒤 새 메시지가 오면(Chat.lastMessageAt > hiddenAt) 다시 나온다 — 쓰기 없이 비교로.
  // 방도 대화도 지우지 않는다(상대에게는 아무 변화가 없다).
  hiddenAt   DateTime?
  joinedAt   DateTime  @default(now())

  @@unique([chatId, userId])
  @@index([userId])
}

model ChatMessage {
  id             Int      @id @default(autoincrement())
  chatId         Int
  chat           Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User     @relation("chatSender", fields: [senderId], references: [id], onDelete: Cascade)
  // 첨부만 있는 메시지(사진/동영상/파일)는 본문이 빈 문자열일 수 있다
  content        String   @default("")
  // 첨부 (사진/동영상/파일 한 건). 없으면 모두 null.
  attachmentUrl  String? // 업로드된 파일 주소
  attachmentType String? // IMAGE | VIDEO | FILE
  attachmentName String? // 원본 파일명 (FILE 다운로드 표시용)
  attachmentSize Int? // 바이트 (용량 표시용)
  // 맥락 카드(2026-11-19) — 작품·공모·전시·갤러리 문의일 때 무엇에 대한 말인지. `{type,id,title,sub,image,link}`.
  // ⚠️ **서버만 만든다**(lib/chatRef.ts) — 화면은 `{type,id}` 만 보내고, 서버가 그 대상이 있는지·공개인지 본 뒤 제목·그림·링크를 찍어 넣는다.
  //    화면이 보낸 제목·링크를 그대로 저장하면 남의 이름·바깥 주소를 단 카드를 상대 화면에 밀어 넣을 수 있다.
  ref            Json?
  createdAt      DateTime @default(now())

  @@index([chatId, createdAt])
}

/// ArtTalk 차단(2026-11-19) — 둘 사이의 갠톡 열기·보내기를 **양쪽 모두** 막는다(누가 막았는지는 알리지 않는다).
/// 단체방(공모방)에는 걸지 않는다 — 운영 공지를 못 받게 되면 안 된다. 상태를 적어 보내는 API(규칙 46) — createMany skipDuplicates / deleteMany.
model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId Int
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// ArtTalk 신고(2026-11-19, 규칙 33 을 닫는다 — 옛 `MessageReport` 는 옛 쪽지만 받았다).
/// 관리자는 방을 직접 열 수 없다(남의 방 404) — 신고할 때 찍어 둔 **사본(`snapshot`)** 만 본다(그 메시지와 앞뒤 몇 줄).
/// `messageId` 0 = 메시지가 아니라 그 사람(갠톡 방) 신고. 같은 사람이 같은 것을 두 번 신고하지 못한다(unique → 409).
/// chatId·messageId 에 FK 를 두지 않는다 — 공모가 지워져 방이 사라져도 신고 기록은 남아야 한다.
model ChatReport {
  id           Int       @id @default(autoincrement())
  reporterId   Int
  reporter     User      @relation("chatReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  chatId       Int
  messageId    Int       @default(0)
  targetUserId Int
  target       User      @relation("chatReportTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  reason       String // SPAM | ABUSE | SCAM | ETC
  detail       String?
  snapshot     Json
  status       String    @default("OPEN") // OPEN | DONE | DISMISSED
  adminNote    String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  @@unique([reporterId, chatId, messageId])
  @@index([status, createdAt])
}

/// 갤러리가 직접 적는 **지난 활동 기록** (2026-09-16)
///
/// `Exhibition`(아트링크 공모)·`Show`(전시 등록)와 다르다 — 그 둘은 우리 플랫폼에서 **진행한** 것이고,
/// 이건 아트링크와 무관하게 갤러리가 해 온 전시·아트페어를 **사후에 적어 두는 기록**이다.
/// 승인 절차가 없고(지원·정산 같은 뒷단계가 없으므로), 공개 갤러리 페이지의 '지난 전시·아트페어'에
/// 아트링크 공모와 **한 줄로 섞여** 날짜순으로 나온다. 작가가 갤러리를 고를 때 보는 이력이다.
model GalleryArchive {
  id        Int       @id @default(autoincrement())
  galleryId Int
  gallery   Gallery   @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  title     String
  /// 장소 — "서울 코엑스", "갤러리 엠 2층". 갤러리 자기 공간이면 비워 둔다.
  venue     String?
  /// 기간 표기 — 자유 텍스트("2026.10.1 – 10.4", "2025 가을"). 화면에 그대로 찍힌다.
  period    String?
  /// 정렬용 날짜(대개 시작일). 없으면 만든 순서로 내려간다.
  date      DateTime?
  /// 참여 작가 — 자유 텍스트(회원이 아닌 작가도 적는다)
  artists   String?
  /// 후기·설명
  body      String?
  /// 사진 — **우리 저장소 주소만**(routes/gallery.ts 가 검증). 외부 URL 주입 방지.
  images    String[]  @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([galleryId, date])
}

// 공모 초대 코드 (2026-09-27) — 이미 선정이 끝난 공모를 ArtLink 로 옮겨 올 때, 갤러리가 코드 하나를 선정 작가들에게 돌리면
// 코드를 넣은 작가가 **지원서 없이 곧바로 수락(ACCEPTED)** 된다. 공모당 하나, 행이 없으면 코드 없음(끔).
// 새로 발급하면 옛 코드는 그 순간 죽는다. 형식·판정은 lib/inviteCode.ts 한 곳. 정원(=선정 인원)은 그대로 지킨다.
// ⚠️⚠️ **Exhibition 컬럼으로 두지 말 것.** 공모 상세·목록 라우트가 행을 통째로(`...exhibition`) 내려주므로 컬럼이면
//    공개 응답에 코드가 그대로 실린다 — 코드는 곧 수락 권한이다. 별도 테이블은 `include` 하지 않는 한 절대 딸려 나가지 않는다.
model ExhibitionJoinCode {
  exhibitionId Int        @id
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  code         String     @unique
  createdAt    DateTime   @default(now())
}

/// 일간 방문 기록 (2026-09-28, Admin [통계] 탭) — **기기 × KST 날짜** 하나에 한 줄.
/// 기기 id 는 브라우저가 만든 무작위 문자열(localStorage)이라 개인정보가 아니다. IP·주소·브라우저 정보는 남기지 않는다.
/// 같은 날 로그인하면 그 줄에 userId 가 붙는다 — 그래서 '비회원으로 들어와 로그인한 사람'은 회원 1명으로 센다.
/// 회원 수 = 그날 서로 다른 userId(Admin 제외), 비회원 수 = userId 없는 줄(기기) 수.
model DailyVisit {
  id        Int      @id @default(autoincrement())
  day       DateTime @db.Date // KST 달력 날짜 — 서버가 정한다(기기 시계를 믿지 않는다)
  visitorId String
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([day, visitorId])
  @@index([day])
}

/// 비회원 둘러보기 — 방문 하나 (2026-10-03, Admin [통계] 탭). 로그인하지 않은 방문이 무엇을 보고 얼마나 머물렀는지.
/// ⚠️ 사람을 알아볼 수 있는 값은 없다 — id 는 화면이 **방문마다 새로** 만드는 무작위 값이다(기기 번호 `DailyVisit.visitorId` 와 다른 값,
///    탭을 닫거나 30분 쉬면 새로 만든다). 계정·IP 와 연결하지 않고 90일 뒤 지운다. 규칙은 `lib/guestActivity.ts`.
model GuestVisit {
  id         String          @id
  startedAt  DateTime        @default(now())
  lastSeenAt DateTime        @default(now())
  /// 이 방문이 로그인·가입으로 이어졌는가 — LOGIN | SIGNUP (계정 번호는 남기지 않는다)
  outcome    String?
  /// 창을 닫거나 다른 사이트로 떠난 때(pagehide). 같은 방문이 이어지면(새로고침·카카오에서 돌아옴) 다시 비운다 —
  /// 이게 없으면 마지막 기록 뒤 30분 동안은 나갔는지 보는 중인지 가를 수 없다
  leftAt     DateTime?
  views      GuestPageView[]

  @@index([startedAt])
  @@index([lastSeenAt])
}

/// 비회원 둘러보기 — 본 화면 하나. 경로는 검색어 등을 뺀 것(허용한 `tab`·`work` 만 남긴다), 머문 시간은 화면이 보이는 동안만(상한 30분).
model GuestPageView {
  id         Int        @id @default(autoincrement())
  visitId    String
  visit      GuestVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  /// 방문 안에서 몇 번째 화면인가(0부터) — 같은 화면을 다시 보내면 머문 시간만 늘린다
  seq        Int
  path       String
  durationMs Int        @default(0)
  createdAt  DateTime   @default(now())

  @@unique([visitId, seq])
}

/// 포트폴리오 PDF 저장 기록 (2026-10-03, Admin [통계] 탭) — 만들기 화면에서 저장할 때마다 한 줄.
/// 파일은 브라우저가 만들고 서버에 남지 않는다. 날짜·작가·쪽수·방식만 적는다(몇 명이 이 기능을 쓰는지 알 길이 없었다).
/// 규칙은 `lib/exportStats.ts`.
/// 작품 가격(원) — 2026-10-15 작가 요청 "포트폴리오나 홈페이지에 작품 금액도 원할 때 넣게".
/// ⚠️⚠️ PortfolioImage 의 컬럼으로 옮기지 말 것 — 공개 홈페이지(GET /portfolio/:id)와 갤러리의 지원자 목록이 작품 행을
/// **통째로** 내려준다. 컬럼이면 작가가 꺼 둔 가격이 응답에 그대로 실린다(초대 코드를 ExhibitionJoinCode 로 뗀 것과 같은 이유).
/// 공개 쪽은 `Portfolio.showPrice` 가 켜졌을 때 `lib/artworkPrice.ts` 를 거쳐서만 싣는다.
model ArtworkPrice {
  imageId   Int            @id
  image     PortfolioImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  /// 원 단위 정수 — 1 ~ 2,000,000,000(Postgres int 상한 아래)
  amount    Int
  updatedAt DateTime       @updatedAt
}

model PortfolioExport {
  id        Int      @id @default(autoincrement())
  day       DateTime @db.Date // KST 달력 날짜 — 서버가 정한다
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// download(바로 내려받기) | print(인쇄 창 — 글자가 살아 있는 PDF) | pptx
  method    String
  pages     Int
  works     Int
  /// 내 홈페이지 [포트폴리오] 탭에도 올렸는가
  uploaded  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([day])
  @@index([userId, day])
}

/// 이메일 인증번호 (2026-10-08) — 갤러리 이메일 가입(SIGNUP) · 비밀번호 찾기(RESET). 규칙은 `lib/emailCode.ts`.
/// 번호는 **해시로만** 남긴다. 10분 안에 맞혀야 하고(5번 틀리면 그 번호는 끝), 맞힌 뒤 30분 안에 가입·재설정에 **한 번** 쓴다.
/// 하루 지난 줄은 새 번호를 보낼 때 지운다(개인정보처리방침 3항).
model EmailCode {
  id         Int       @id @default(autoincrement())
  /// 소문자로 맞춘 주소
  email      String
  /// SIGNUP | RESET
  purpose    String
  codeHash   String
  /// 틀린 횟수 — 맞혀 보기 전에 먼저 올린다(동시에 여러 번 넣어도 5번을 못 넘긴다)
  attempts   Int       @default(0)
  expiresAt  DateTime
  /// 번호를 맞힌 시각
  verifiedAt DateTime?
  /// 가입·재설정에 쓴 시각 — 한 번만 쓴다
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose, createdAt])
  @@index([createdAt])
}

/// 공모 첨부파일을 받은 수 — 날짜별(2026-11-21, 관리자 통계). 바깥 접수 공고는 지원 수 대신 이걸로 관심을 본다.
/// 한 줄 = 공모 × KST 날짜. 받은 사람·기기는 남기지 않는다(수만 센다) · 관리자와 그 공모 운영자는 세지 않는다.
model ExhibitionAttachmentHit {
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  day          DateTime   @db.Date
  count        Int        @default(0)

  @@id([exhibitionId, day])
  @@index([day])
}
