generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 사용자 모델
model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  nickname     String?   @unique // 공개 표시명 (설정 시 이름 대신 노출), 중복 불가
  role         String // ARTIST, GALLERY, ADMIN
  avatar       String?
  phone        String? // 가입 시 입력받는 연락처 (기존 유저는 null 허용)
  instagramUrl String? // 작가 프로필 인스타그램 주소 (선택)
  password     String? // bcrypt hash (LOCAL auth only)
  provider     String    @default("LOCAL") // LOCAL, KAKAO, NAVER, GOOGLE
  providerId   String? // OAuth provider user ID
  deletedAt    DateTime? // 회원탈퇴(소프트 삭제) 시각. null 아니면 로그인 차단 + 공개 표시 '탈퇴한 회원'
  lastSeenAt   DateTime? // 최근 인증된 접속 시각. 기존 유저는 다음 접속 전까지 null
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  galleries             Gallery[]
  reviews               Review[]
  favorites             Favorite[]
  portfolio             Portfolio?
  applications          Application[]
  notifications         Notification[]
  inquiries             Inquiry[]
  portfolioImageLikes   PortfolioImageLike[]
  sentMessages          Message[]              @relation("sentMessages")
  receivedMessages      Message[]              @relation("receivedMessages")
  messageReports        MessageReport[]        @relation("messageReports")
  chatParticipations    ChatParticipant[]
  chatMessages          ChatMessage[]          @relation("chatSender")
  chatsCreated          Chat[]                 @relation("chatCreator")
  exhibitionSubmissions ExhibitionSubmission[]
  submissionEdits       ExhibitionSubmission[] @relation("submissionEditor") // 갤러리/Admin 이 대신 입력해 준 작가 자료
  artworkSales          ArtworkSale[]          @relation("artworkSales")
  artistSettlements     ArtistSettlement[]     @relation("artistSettlements")
  settlementApprovals   SettlementApproval[]   @relation("settlementApprovals")
  artworkScraps         ArtworkScrap[]         @relation("artworkScraps")
  invitesReceived       ExhibitionInvite[]     @relation("invitesReceived")
  invitesSent           ExhibitionInvite[]     @relation("invitesSent")
  kanbanBoards          KanbanBoard[]          @relation("kanbanBoardCreator")
  kanbanCardsAssigned   KanbanCard[]           @relation("kanbanAssignee")
  kanbanCardsCreated    KanbanCard[]           @relation("kanbanCardCreator")
  kanbanComments        KanbanComment[]        @relation("kanbanCommentAuthor")
  posts                 Post[]                 @relation("postAuthor")
  postComments          PostComment[]          @relation("postCommentAuthor")
  postLikes             PostLike[]             @relation("postLiker")
  following             Follow[]               @relation("follower")   // 내가 이웃 추가한 사람들
  followers             Follow[]               @relation("following")  // 나를 이웃 추가한 사람들
  stories               Story[]                @relation("storyAuthor")
  storyLikes            StoryLike[]            @relation("storyLiker")
  storyComments         StoryComment[]         @relation("storyCommentAuthor")
  guestbookReceived     GuestbookEntry[]       @relation("guestbookTarget") // 내 방명록에 달린 글
  guestbookWritten      GuestbookEntry[]       @relation("guestbookAuthor") // 내가 남긴 방명록 글

  @@unique([provider, providerId])
}

// ── 방명록 (작가 홈페이지의 방명록) ──
// target 의 홈페이지에 author 가 남긴 글. 방 주인은 답글(parentId)을 달 수 있다.
// secret 이면 방 주인과 작성자만 본문을 볼 수 있다.
model GuestbookEntry {
  id           Int              @id @default(autoincrement())
  targetUserId Int
  target       User             @relation("guestbookTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  authorId     Int
  author       User             @relation("guestbookAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body         String
  secret       Boolean          @default(false)
  parentId     Int?
  parent       GuestbookEntry?  @relation("guestbookReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      GuestbookEntry[] @relation("guestbookReplies")
  createdAt    DateTime         @default(now())

  @@index([targetUserId, createdAt])
}

// ── 이웃 (단방향 팔로우) ──
// follower → following. 상대 수락 불필요. following 에게 알림만 간다.
model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId Int
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ── 스토리 (작업 중 사진 + 짧은 글) ──
// 별도 [소식] 피드에 뜬다. visibility 는 **글마다** — PUBLIC(전체공개) | NEIGHBORS(이웃공개).
model Story {
  id           Int            @id @default(autoincrement())
  authorId     Int
  author       User           @relation("storyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  caption      String         @default("")
  images       String[]       @default([])
  visibility   String         @default("NEIGHBORS") // PUBLIC | NEIGHBORS
  likeCount    Int            @default(0)  // 비정규화 카운트
  commentCount Int            @default(0)
  likes        StoryLike[]
  comments     StoryComment[]
  createdAt    DateTime       @default(now())

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model StoryLike {
  id        Int      @id @default(autoincrement())
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("storyLiker", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
}

model StoryComment {
  id        Int      @id @default(autoincrement())
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation("storyCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([storyId, createdAt])
}

// ── 광고 배너 (Admin 관리) — 사이드바 하단 등에 노출하는 자체 광고 슬롯 ──
model AdBanner {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  title     String   @default("")
  linkUrl   String   @default("")
  active    Boolean  @default(true)
  position  Int      @default(0)   // 정렬(작을수록 먼저)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

// ── 커뮤니티 게시판 (블라인드식 글로벌 게시판, 홈 인기글의 출처) ──
model Post {
  id        Int      @id @default(autoincrement())
  authorId  Int
  author    User     @relation("postAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  // 첨부 사진 (우리 저장소 주소만). 순서 유지.
  images    String[] @default([])
  // 글마다 실명(닉네임+역할)/익명 선택 — true 면 응답에서 작성자 신원을 가린다
  anonymous Boolean  @default(false)
  // 랭킹·목록을 매번 집계하지 않으려고 비정규화해서 들고 있는다
  likeCount    Int   @default(0)
  commentCount Int   @default(0)
  viewCount    Int   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments PostComment[]
  likes    PostLike[]

  @@index([createdAt])
  @@index([likeCount])
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation("postCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("postLiker", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

// 갤러리 모델
model Gallery {
  id                      Int       @id @default(autoincrement())
  name                    String
  address                 String
  phone                   String
  description             String
  detailDesc              String? // 상세 소개 (승인 후 수정 가능)
  region                  String // SEOUL, GYEONGGI_NORTH, GYEONGGI_SOUTH, DAEJEON, BUSAN
  rating                  Float     @default(0)
  reviewCount             Int       @default(0)
  viewCount               Int       @default(0) // 상세 페이지 조회수 (Admin 통계용, 비-관리자/비-소유자 조회 시 증가)
  status                  String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectReason            String?
  ownerName               String
  mainImage               String?
  instagramUrl            String? // 인스타그램 주소 (@handle) — 연동 시 저장, 연결 해제 전까지 유지
  instagramAccessToken    String? // Instagram 장기 액세스 토큰(60일, 서버 전용) — OAuth로 발급
  instagramTokenExpiresAt DateTime? // 장기 토큰 만료 시각 — 만료 임박 시 갱신
  instagramFeedVisible    Boolean   @default(false) // 피드 공개 여부
  instagramProfileVisible Boolean   @default(false) // 프로필 링크 공개 여부
  email                   String? // 갤러리 이메일 주소
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  ownerId            Int
  owner              User                @relation(fields: [ownerId], references: [id])
  images             GalleryImage[]
  exhibitions        Exhibition[]
  managedExhibitions ExhibitionManager[] // 아트링크 주최 공모 중 이 갤러리가 운영을 위임받은 것
  shows              Show[]
  reviews            Review[]
  favorites          Favorite[]
  galleryOfMonth     GalleryOfMonth?

  @@index([ownerId])
  @@index([status, region])
  @@index([rating])
}

// 갤러리 이미지
model GalleryImage {
  id        Int     @id @default(autoincrement())
  url       String
  order     Int     @default(0)
  galleryId Int
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
}

// 공모 사진 (다중, 순서변경 가능) — 첫 사진(order 최소)이 대표 이미지로 imageUrl과 동기화
model ExhibitionImage {
  id           Int        @id @default(autoincrement())
  url          String
  order        Int        @default(0)
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

  @@index([exhibitionId])
}

// 전시/공모 모델
model Exhibition {
  id                    Int       @id @default(autoincrement())
  title                 String
  type                  String // SOLO, GROUP, ART_FAIR
  deadline              DateTime // 공모 마감일
  deadlineStart         DateTime? // 공모 시작일
  exhibitDate           DateTime // 전시 종료일
  exhibitStartDate      DateTime? // 전시 시작일
  capacity              Int
  region                String
  description           String
  imageUrl              String? // 공모 대표 이미지
  customFields          String? // 커스텀 질문 항목 (JSON 문자열: [{id, label, type, required, options}])
  viewCount             Int       @default(0) // 상세 페이지 조회수 (Admin 통계용, 비-관리자/비-소유자 조회 시 증가)
  status                String    @default("PENDING") // PENDING, APPROVED, REJECTED (승인 상태)
  rejectReason          String?
  hostType              String    @default("GALLERY") // GALLERY(갤러리 주최, 기본) | ADMIN(아트링크 주최 — 운영은 managers 갤러리들에게 위임)
  // 작가가 출품자료(출품리스트·약력·노트)를 내야 하는 마감일. 지원마감 < 이 날짜 < 전시시작.
  // 신규 등록은 필수지만, 2026-08-19 이전에 올라간 공모는 값이 없어 nullable 이다
  // (갤러리가 공모 상세에서 한 번 채워 넣고, 그 뒤로는 Admin 만 고칠 수 있다).
  submissionDeadline    DateTime?
  recruitmentClosed     Boolean   @default(false) // 모집마감 (수동 내림 → 목록 비노출)
  confirmed             Boolean   @default(false) // 확정 (작가 전시정보 수정 잠금). 전시 시작일 경과 시 자동 확정 처리
  ended                 Boolean   @default(false) // 전시종료 (정산 단계)
  settlementRequestedAt DateTime? // 정산 확인 요청 시각. non-null=작가 확인 대기(정산 수정 잠금 + 작가에게 검토 공개)
  settledAt             DateTime? // 정산 완료 시각. non-null=정산 확정(운영페이지 수정 잠금 + 작가에게 정산 공개)
  // 카드 결제 수수료율(%). 카드로 팔린 작품 합계에서 먼저 떼고 남은 금액을 갤러리:작가 비율로 나눈다.
  // 현금 판매분에는 붙지 않는다. 0이면 예전과 완전히 같은 계산(기본값) — lib/settlementFingerprint.ts 참고.
  cardFeeRate           Float     @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  galleryId           Int
  gallery             Gallery                @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  managers            ExhibitionManager[]
  applications        Application[]
  favorites           Favorite[]
  promoPhotos         PromoPhoto[]
  images              ExhibitionImage[]
  messages            Message[]
  reviews             Review[]
  notices             ExhibitionNotice[]
  submissions         ExhibitionSubmission[]
  sales               ArtworkSale[]
  settlements         ArtistSettlement[]
  settlementApprovals SettlementApproval[]
  invites             ExhibitionInvite[]
  chat                Chat?

  @@index([galleryId])
  @@index([status, deadline])
  @@index([region])
}

// 아트링크(Admin) 주최 공모의 운영 갤러리 — 이 갤러리 오너는 해당 공모를 소유 갤러리처럼 운영할 수 있다.
//
// ⚠️ hostType='ADMIN' 인 공모에서만 의미가 있다. 갤러리가 직접 등록한 공모(hostType='GALLERY')에는
//    행을 만들지 않고, 권한 판정에서도 hostType 을 먼저 확인한다(lib/exhibitionAccess.ts).
//    "운영 위임은 아트링크가 주최할 때만" 이라는 규칙을 데이터와 코드 양쪽에서 지키기 위함.
//
// galleryId 는 여전히 필수(주관 갤러리)이며 반드시 이 목록에 함께 들어간다 —
// 목록 카드·정산·통계 등 기존 코드 전부가 exhibition.gallery 를 전제로 하기 때문이다.
model ExhibitionManager {
  id           Int        @id @default(autoincrement())
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  galleryId    Int
  gallery      Gallery    @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([exhibitionId, galleryId])
  @@index([galleryId])
}

// 전시 종료 후 홍보 사진
model PromoPhoto {
  id           Int        @id @default(autoincrement())
  url          String
  caption      String?
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

// 히어로 슬라이드
model HeroSlide {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String
  linkUrl     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 혜택
model Benefit {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  linkUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 이달의 갤러리
model GalleryOfMonth {
  id        Int      @id @default(autoincrement())
  galleryId Int      @unique
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  title     String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// 리뷰
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int // 1-5
  content   String
  imageUrl  String?
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId       Int
  user         User        @relation(fields: [userId], references: [id])
  galleryId    Int
  gallery      Gallery     @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  exhibitionId Int?
  exhibition   Exhibition? @relation(fields: [exhibitionId], references: [id], onDelete: SetNull)

  @@index([galleryId])
  @@index([userId])
}

// 찜하기
model Favorite {
  id           Int         @id @default(autoincrement())
  userId       Int
  user         User        @relation(fields: [userId], references: [id])
  galleryId    Int?
  gallery      Gallery?    @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  exhibitionId Int?
  exhibition   Exhibition? @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  showId       Int?
  show         Show?       @relation(fields: [showId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@unique([userId, galleryId])
  @@unique([userId, exhibitionId])
  @@unique([userId, showId])
  @@index([userId])
  // 역방향 조회/부모 삭제(cascade) 시 seq scan 방지
  @@index([galleryId])
  @@index([exhibitionId])
  @@index([showId])
}

// 포트폴리오
model Portfolio {
  id                Int              @id @default(autoincrement())
  biography         String?
  exhibitionHistory String? // (구) 전시이력 단일 텍스트 — career로 대체, 하위호환 위해 컬럼 유지
  career            String? // 경력 JSON: { artFair:[{year,content}], solo:[...], group:[...], education?, award? }
  portfolioFileUrl  String? // 포트폴리오 파일(pdf/doc/hwp) URL
  statement         String? // 작가노트(ARTIST STATEMENT) — 약력(biography)과 별개. 갤러리가 가장 먼저 읽는 글
  tagline           String? // 한 줄 소개 — 포맷 PDF 표지 부제
  themeId           String? // 마지막으로 고른 포트폴리오 포맷 (gallery|studio|story|archive)
  seriesInfo        String? // 시리즈 설명 JSON: [{ name, note }]
  designConfig      String? // 가이드형 디자인 JSON: { theme, works, sections:[{id,enabled}] }. null=기본(현재 모습)
  userId            Int              @unique
  user              User             @relation(fields: [userId], references: [id])
  images            PortfolioImage[]
  updatedAt         DateTime         @updatedAt
}

// 포트폴리오 이미지
model PortfolioImage {
  id            Int                  @id @default(autoincrement())
  url           String
  order         Int                  @default(0)
  showInExplore Boolean              @default(false)
  // ── 작품 정보 ──
  // 실제 작가 포트폴리오는 예외 없이 [제목/재료/크기/제작연도]를 작품마다 붙인다(샘플 5종 전부).
  // 없으면 캡션이 통째로 빠지므로 전부 nullable — 있는 항목만 조립한다(lib/artwork.ts).
  title         String?
  medium        String? // 재료 (예: Acrylic on canvas)
  sizeText      String? // 크기 (예: 72.7 × 90.9 cm) — 자유 텍스트
  year          String? // 제작연도
  series        String? // 시리즈명 — 포맷 PDF에서 이 값으로 묶고 시리즈 표지를 만든다
  description   String? // 작품 설명 / 서사
  status        String? // AVAILABLE | SOLD | NFS(비매) — null이면 표기 안 함
  portfolioId   Int
  portfolio     Portfolio            @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  likes         PortfolioImageLike[]
  scraps        ArtworkScrap[]
}

// 포트폴리오 이미지 좋아요
model PortfolioImageLike {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageId   Int
  image     PortfolioImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, imageId])
  @@index([imageId])
  @@index([userId])
}

// 지원
model Application {
  id               Int        @id @default(autoincrement())
  userId           Int
  user             User       @relation(fields: [userId], references: [id])
  exhibitionId     Int
  exhibition       Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  customAnswers    String? // (구) 커스텀 질문 답변 — 고정 양식으로 대체, 하위호환 위해 컬럼 유지
  biography        String? // 지원 시 작가 약력 (필수)
  career           String? // 지원 시 경력 JSON: { artFair:[{year,content}], solo:[...], group:[...] }
  artworkImages    String? // 지원 시 작품 사진 URL 배열 JSON (최대 10, 1장 이상 필수)
  portfolioFileUrl String? // 지원 시 포트폴리오 파일(pdf/doc/hwp) URL
  termsAgreedAt    DateTime? // 작가 지원 약관 동의 시각
  termsVersion     String? // 동의한 작가 지원 약관 버전
  termsTextHash    String? // 동의한 약관 전문의 해시(SHA-256)
  status           String     @default("SUBMITTED") // SUBMITTED, REVIEWED, ACCEPTED, REJECTED
  rejectionAckedAt DateTime? // 거절을 작가가 '확인'한 시각. non-null이면 지원내역 목록에서 숨김
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt // 상태 변경(수락/거절 등) 시각 추적

  @@unique([userId, exhibitionId])
  @@index([userId])
  // 지원마다 실행되는 정원 count + 지원자 목록이 exhibitionId로 필터 → 인덱스 필요
  @@index([exhibitionId])
}

// 전시 (갤러리의 실제 전시/행사 소개)
model Show {
  id           Int         @id @default(autoincrement())
  title        String
  description  String
  startDate    DateTime
  endDate      DateTime
  openingHours String // "10:00-18:00"
  admissionFee String // "무료" or "5,000원"
  location     String
  region       String // SEOUL, GYEONGGI_NORTH 등 (필터용)
  artists      String? // JSON: ["작가1","작가2"]
  posterImage  String
  viewCount    Int         @default(0) // 상세 페이지 조회수 (Admin 통계용, 비-관리자/비-소유자 조회 시 증가)
  status       String      @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectReason String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  galleryId    Int
  gallery      Gallery     @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  images       ShowImage[]
  favorites    Favorite[]

  @@index([galleryId])
  @@index([status, region])
}

// 전시 추가 이미지
model ShowImage {
  id     Int    @id @default(autoincrement())
  url    String
  order  Int    @default(0)
  showId Int
  show   Show   @relation(fields: [showId], references: [id], onDelete: Cascade)
}

// 인앱 알림
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // APPLICATION_STATUS, NEW_APPLICANT, APPROVAL_RESULT, ARTWORK_LIKE, EXHIBITION_INVITE
  message   String
  linkUrl   String?
  refKey    String? // 집계용 키(예: "artwork-like:123") — 같은 대상의 알림을 새로 쌓지 않고 갱신하는 데 사용
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
  @@index([userId, refKey])
}

// 자주 묻는 질문 (Admin 작성, 전체 공개)
model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  order     Int      @default(0)
  category  String   @default("GENERAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 1:1 문의
model Inquiry {
  id        Int       @id @default(autoincrement())
  subject   String
  content   String
  status    String    @default("OPEN") // OPEN, ANSWERED
  reply     String?
  repliedAt DateTime?
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

// 승인 요청 (갤러리/공모 수정 요청)
model ApprovalRequest {
  id           Int      @id @default(autoincrement())
  type         String // GALLERY_EDIT, EXHIBITION_EDIT
  targetId     Int // galleryId or exhibitionId
  changes      String // JSON string of requested changes
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectReason String?
  requesterId  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// 메시지 (Artist ↔ Gallery 소통)
model Message {
  id           Int             @id @default(autoincrement())
  subject      String
  content      String
  read         Boolean         @default(false)
  senderId     Int
  sender       User            @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId   Int
  receiver     User            @relation("receivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  exhibitionId Int?
  exhibition   Exhibition?     @relation(fields: [exhibitionId], references: [id], onDelete: SetNull)
  attachments  String?
  createdAt    DateTime        @default(now())
  reports      MessageReport[]

  @@index([receiverId, read])
  @@index([senderId])
  @@index([exhibitionId])
  @@index([createdAt])
}

// 메시지 신고
model MessageReport {
  id         Int      @id @default(autoincrement())
  messageId  Int
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId Int
  reporter   User     @relation("messageReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  detail     String?
  status     String   @default("PENDING")
  adminNote  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([messageId, reporterId])
  @@index([status])
  @@index([createdAt])
}

// 공모 운영 페이지 — 갤러리 공지사항
model ExhibitionNotice {
  id           Int        @id @default(autoincrement())
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  title        String
  content      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  @@index([exhibitionId])
}

// 공모 운영 페이지 — 수락 작가가 제출하는 전시 정보 (출품리스트/작가약력/작가노트)
model ExhibitionSubmission {
  id                  Int        @id @default(autoincrement())
  exhibitionId        Int
  exhibition          Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  userId              Int
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  artworkList         String? // JSON: [{image,title,size,medium,year,price}]
  cv                  String? // JSON: {nameKo,nameEn,birth,tel,email,education[],solo[],group[],artFair[],award[]} (각 항목 [{year,content}])
  note                String? // JSON: {statement, sections:[{title,body}]}
  representativeIndex Int? // 엽서용 대표작 — artworkList 내 인덱스 (작가가 선택, null=미선택)
  // 마지막으로 저장한 사람. null 이거나 userId 와 같으면 작가 본인이 쓴 것,
  // 다르면 갤러리/Admin 이 대신 입력한 것이다(자료 업로드가 어려운 작가를 돕는 경로).
  // 작가가 나중에 직접 고치면 다시 본인 id 로 덮여 '대신 입력' 표시가 사라진다.
  updatedById         Int?
  updatedBy           User?      @relation("submissionEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt           DateTime   @default(now()) @updatedAt

  @@unique([exhibitionId, userId])
  @@index([exhibitionId])
}

// 판매된 작품 (전시종료 후 갤러리가 입력) — 작가 출품리스트의 index 기준
model ArtworkSale {
  id            Int        @id @default(autoincrement())
  exhibitionId  Int
  exhibition    Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  artistUserId  Int
  artist        User       @relation("artworkSales", fields: [artistUserId], references: [id], onDelete: Restrict)
  artworkIndex  Int // 해당 작가 artworkList 내 인덱스
  title         String // 작품명 스냅샷
  soldPrice     Int // 판매가 (원)
  paymentMethod String     @default("CARD") // CARD(카드) | CASH(현금)

  @@unique([exhibitionId, artistUserId, artworkIndex])
  @@index([exhibitionId])
  @@index([artistUserId])
}

// 작가별 정산 비율 (전시종료 후 갤러리가 입력) — galleryRatio: 갤러리 몫 %, 작가 = 100 - galleryRatio
model ArtistSettlement {
  id           Int        @id @default(autoincrement())
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  artistUserId Int
  artist       User       @relation("artistSettlements", fields: [artistUserId], references: [id], onDelete: Restrict)
  galleryRatio Int        @default(0) // 0~100

  @@unique([exhibitionId, artistUserId])
  @@index([exhibitionId])
  @@index([artistUserId])
}

// 정산 확인 승인 — 갤러리가 [정산 확인 요청] 시 수락 작가별 1행 생성. 전원 APPROVED여야 갤러리가 정산 완료 가능.
model SettlementApproval {
  id             Int        @id @default(autoincrement())
  exhibitionId   Int
  exhibition     Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  artistUserId   Int
  artist         User       @relation("settlementApprovals", fields: [artistUserId], references: [id], onDelete: Restrict)
  status         String     @default("PENDING") // PENDING(미응답) | APPROVED(수락) | ISSUE(문제제기)
  comment        String? // 문제 제기 시 갤러리에 전달할 코멘트
  // 응답 당시 정산 금액의 지문(lib/settlementFingerprint.ts). 갤러리가 이 작가 금액을 고치면
  // 지문이 어긋나 자동으로 PENDING 으로 되돌아간다 → 금액이 그대로인 작가는 수락이 유지된다.
  // null = 옛 데이터/미응답. 옛 APPROVED 행은 첫 저장 때 한 번 재확인 대상이 된다(안전한 방향).
  snapshot       String?
  // 이 작가에게 **마지막으로 물어본** 시각. 무응답 자동 수락 기한의 기준점이라
  // PENDING 으로 만들 때마다(최초 요청·작가별 재요청·금액 수정으로 인한 초기화) 새로 찍는다.
  // null = 옛 데이터 → 자동 수락 대상이 아니다(경고를 못 받은 사람에게 소급 적용하지 않는다).
  askedAt        DateTime?
  // 무응답으로 자동 수락된 시각. 사람이 직접 누른 수락과 반드시 구분돼야 한다 — 돈 문제라
  // 나중에 "동의한 적 없다"는 다툼이 생기면 이 값이 유일한 근거다.
  autoApprovedAt DateTime?
  updatedAt      DateTime   @default(now()) @updatedAt

  @@unique([exhibitionId, artistUserId])
  @@index([exhibitionId])
  @@index([artistUserId])
}

// 앱 전역 설정 (key-value) — Admin 개발자 도구 토글 등 런타임 플래그 영속화
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// 갤러리의 비공개 스카우팅 보드 — 둘러보기에서 마음에 든 작품을 저장(작가에게 노출되지 않음)
model ArtworkScrap {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation("artworkScraps", fields: [userId], references: [id], onDelete: Cascade)
  imageId   Int
  image     PortfolioImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  memo      String? // 갤러리만 보는 메모
  createdAt DateTime       @default(now())

  @@unique([userId, imageId])
  @@index([userId])
}

// 갤러리 → 작가 공모 초대 (초대일 뿐 자동 지원 아님 — 작가가 직접 지원해야 한다)
model ExhibitionInvite {
  id           Int        @id @default(autoincrement())
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  artistId     Int
  artist       User       @relation("invitesReceived", fields: [artistId], references: [id], onDelete: Cascade)
  senderId     Int
  sender       User       @relation("invitesSent", fields: [senderId], references: [id], onDelete: Cascade)
  message      String?
  status       String     @default("SENT") // SENT(전송) | APPLIED(지원함) | DECLINED(작가가 숨김)
  createdAt    DateTime   @default(now())

  @@unique([exhibitionId, artistId])
  @@index([artistId, status])
  @@index([exhibitionId])
}

// ===== Admin 전용 할 일 보드 (회의 내용·할 일 정리) =====
// 공개 API 없음. 모든 라우트가 authorize('ADMIN') 뒤에 있다 — 보드 제목·항목 본문·댓글에
// 회의 내용이 그대로 들어가므로 역할 검증을 빼면 곧바로 내부 논의가 새어 나간다.
//
// 이름이 Kanban* 인 이유: 처음엔 3열 칸반으로 만들었다가 목록형 체크리스트로 바꿨다.
// 테이블명만 남았을 뿐 열(column) 개념은 없다 — 완료 여부는 doneAt 하나로 판정한다.

model KanbanBoard {
  id          Int          @id @default(autoincrement())
  title       String
  description String? // 보드 부제(무엇을 모아두는 보드인지)
  position    Int          @default(0) // 보드 목록 내 정렬 순서 (0부터 연속, 이동 시 서버가 재부여)
  createdById Int?
  createdBy   User?        @relation("kanbanBoardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  cards       KanbanCard[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([position])
}

model KanbanCard {
  id          Int             @id @default(autoincrement())
  boardId     Int
  board       KanbanBoard     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title       String
  body        String? // 회의 내용·상세 메모
  assigneeId  Int?
  assignee    User?           @relation("kanbanAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate     DateTime? // KST 달력 날짜 기준으로 판정 (lib/kstDate.ts)
  position    Int             @default(0) // 목록 순서 (0부터 연속, 재정렬 시 서버가 다시 부여)
  doneAt      DateTime? // 체크한 시각. null 이면 아직 안 한 일. 완료 판정은 이 값 하나뿐이다
  createdById Int?
  createdBy   User?           @relation("kanbanCardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments    KanbanComment[]
  subtasks    KanbanSubtask[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([boardId, position])
  @@index([assigneeId])
}

model KanbanComment {
  id        Int        @id @default(autoincrement())
  cardId    Int
  card      KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorId  Int? // 작성자가 하드 삭제돼도 회의 기록은 남긴다 (SetNull, 화면엔 '알 수 없음')
  author    User?      @relation("kanbanCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime   @default(now())

  @@index([cardId, createdAt])
}

// 항목 안의 세부항목(체크리스트). 목록 화면에 그대로 펼쳐 보이고 거기서 바로 체크한다.
//
// 상위 항목과 일부러 다르게 두 가지:
//   ① 담당자·마감일·댓글이 없다 — 그 정도로 무거운 일이면 상위 항목으로 올리는 게 맞다.
//   ② 체크해도 자리가 안 바뀐다(정렬도 position 순 그대로). 서너 줄짜리 목록에서 체크할 때마다
//      줄이 튀어 다니면 다음 걸 누르기가 힘들다.
model KanbanSubtask {
  id        Int        @id @default(autoincrement())
  cardId    Int
  card      KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title     String
  doneAt    DateTime? // 체크한 시각. null 이면 아직 안 한 일 (상위 항목과 같은 규약)
  position  Int        @default(0) // 적은 순서 (0부터 연속)
  createdAt DateTime   @default(now())

  @@index([cardId, position])
}

// ===== 대화 (갠톡 1:1 · 단톡 그룹) =====
//
// 예전 Message 모델은 sender/receiver 한 쌍의 '쪽지'라 단톡을 담을 수 없었고,
// "갤러리↔작가만" 같은 역할 제약이 라우트에 박혀 있어 작가끼리 대화도 못 했다.
// 여기서는 **누가 대화할 수 있는가를 '방에 들어가 있는가'로만** 판정한다 —
// 역할로 막지 않고, 방을 만드는 길목에서만 제한한다(아래).
//
// ⚠️ 임의 검색으로 아무에게나 말을 걸 수 있으면 안 된다. 방이 생기는 길은 둘뿐이다:
//    · 갠톡(DIRECT) — 둘러보기·작가 홈페이지에서 그 사람을 보고 시작
//    · 단톡(GROUP)  — 공모가 승인되면 자동 생성. 갤러리(+Admin 주최면 운영 갤러리)와
//                     수락된 작가가 자동으로 참여자가 된다
model Chat {
  id            Int               @id @default(autoincrement())
  kind          String // DIRECT(1:1) | GROUP(단톡)
  title         String? // 단톡 이름 (공모 제목). 갠톡은 상대 이름을 화면에서 만든다
  // 공모 단톡은 공모당 하나 — 유니크로 중복 생성을 막는다
  exhibitionId  Int?              @unique
  exhibition    Exhibition?       @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  // 갠톡 중복 방지 키 `min-max` (예: "12-45"). 그룹은 null.
  // 유니크 인덱스라 같은 두 사람의 방이 두 개 생기지 않는다.
  directKey     String?           @unique
  createdById   Int?
  createdBy     User?             @relation("chatCreator", fields: [createdById], references: [id], onDelete: SetNull)
  // 목록 정렬용. 메시지를 넣을 때 함께 갱신한다(매번 집계하면 목록이 느려진다)
  lastMessageAt DateTime          @default(now())
  participants  ChatParticipant[]
  messages      ChatMessage[]
  createdAt     DateTime          @default(now())

  @@index([lastMessageAt])
}

model ChatParticipant {
  id         Int       @id @default(autoincrement())
  chatId     Int
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 이 시각 **이후**에 온 메시지가 안 읽음이다. 메시지마다 읽음 행을 쌓지 않는 이유는
  // 단톡 20명 × 메시지 수만큼 행이 늘기 때문 — 시각 하나로 같은 답을 낼 수 있다.
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  @@unique([chatId, userId])
  @@index([userId])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  chatId    Int
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User     @relation("chatSender", fields: [senderId], references: [id], onDelete: Cascade)
  // 첨부만 있는 메시지(사진/동영상/파일)는 본문이 빈 문자열일 수 있다
  content   String   @default("")
  // 첨부 (사진/동영상/파일 한 건). 없으면 모두 null.
  attachmentUrl  String? // 업로드된 파일 주소
  attachmentType String? // IMAGE | VIDEO | FILE
  attachmentName String? // 원본 파일명 (FILE 다운로드 표시용)
  attachmentSize Int? // 바이트 (용량 표시용)
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}
